<div>                 <floatingText>                     <front>                         <titlePage type="main">                             <docTitle>                                 <titlePart type="main"><hi rendition="#c"><hi rendition="#aq"><hi rendition="#b"><hi rendition="#g">Supplément</hi></hi><lb/>
