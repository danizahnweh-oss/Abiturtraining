<milestone unit="section" rendition="#hr"/>                             <lb/>
<div type="jAn">                                 <head><hi rendition="#fr"><hi rendition="#g"><hi rendition="#aq">Frederik</hi> der Sechste,</hi> von Gottes Gnaden                                             Kö-<lb/>
<hi rendition="#et">nig zu Dännemark, Norwegen,                                             der Wenden und<lb/>
