<castList><p><hi rendition="#c"><hi rendition="#g">Per&#x017F;onen</hi>.</hi></p><lb/>
<milestone unit="section" rendition="#hr"/>     <castItem><role xml:id="KURF"><hi rendition="#g">Friedrich Wilhelm</hi>, Kurfür&#x017F;t von Brandenburg.</role></castItem><lb/>
<castItem><role xml:id="KURFI"><hi rendition="#g">Die Kurfür&#x017F;tin</hi>.</role></castItem><lb/>
