<titlePage type="main"><docTitle><titlePart type="main"><hi rendition="#g"><hi rendition="#b">Jllu&#x017F;trirtes<lb/>
Thierleben.</hi></hi></titlePart></docTitle><lb/>
<docTitle><titlePart type="sub"><hi rendition="#g">Eine allgemeine<lb/>
<hi rendition="#b">Kunde des Thierreichs</hi></hi></titlePart></docTitle><lb/>
<byline>von <docAuthor><hi rendition="#b">A. E. Brehm.</hi></docAuthor></byline><lb/>
<docTitle><titlePart type="desc">Mit Abbildungen, ausgeführt unter Leitung von <hi rendition="#b">R. Kret&#x017F;chmer.</hi></titlePart></docTitle><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
