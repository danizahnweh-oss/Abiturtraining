<fw type="sig" place="bottom">E 4</fw><fw type="catch" place="bottom">hielte;</fw><lb/>
<pb n="72" facs="#f0092"/>
<fw type="header" place="top"><hi rendition="#b"><hi rendition="#aq">I.</hi> Kinderhaus u. Accouchier-Ho&#x017F;pital</hi></fw><lb/>
