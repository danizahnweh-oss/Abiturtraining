<titlePage type="main">         <docTitle>           <titlePart type="main">             <hi rendition="#b"><hi rendition="#g">Mu&#x0364;nchhau&#x017F;en</hi>.</hi>           </titlePart>           <lb/>
<milestone unit="section" rendition="#hr"/>           <titlePart type="sub">             <hi rendition="#g">               <hi rendition="#b">Eine Ge&#x017F;chichte in Arabesken</hi>             </hi>           </titlePart>         </docTitle>         <lb/>
<byline>von<lb/>
<docAuthor><hi rendition="#g">Karl Immermann</hi>.</docAuthor></byline>         <lb/>
<milestone unit="section" rendition="#hr"/>         <epigraph>           <cit>             <quote>               <hi rendition="#aq">Non fumum ex fulgore, sed ex fumo dare lucem<lb/>
Cogitat, ut speciosa dehine miracula promat,<lb/>
Antiphatem, Seyllamque et cum Cyclope Charybdim.</hi>             </quote>             <lb/>
<bibl>               <hi rendition="#aq"><hi rendition="#i">Horatius</hi>.</hi>             </bibl>           </cit>         </epigraph>         <lb/>
<milestone unit="section" rendition="#hr"/>         <milestone unit="section" rendition="#hr"/>         <titlePart type="volume"><hi rendition="#g">Zweiter Theil</hi>.</titlePart>         <lb/>
