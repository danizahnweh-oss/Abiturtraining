<pb facs="#f0002"/>
<pb facs="#f0003" n="III"/>
<div type="contents" n="1">       <head><hi rendition="#g">Inhalt</hi>.</head><lb/>
<table>         <row>           <cell/>           <cell rendition="#right">Seite</cell>         </row>         <row>           <cell>Besuche</cell>           <cell rendition="#right">1</cell>         </row>         <row>           <cell>Gesellschaften</cell>           <cell rendition="#right">34</cell>         </row>         <row>           <cell>Essen und Trinken</cell>           <cell rendition="#right">73</cell>         </row>         <row>           <cell>Familienfestlichkeiten</cell>           <cell rendition="#right">117</cell>         </row>         <row>           <cell>Der Verkehr auf der Straße</cell>           <cell rendition="#right">152</cell>         </row>         <row>           <cell>Verkehr im Theater, Konzert u. s. w.</cell>           <cell rendition="#right">180</cell>         </row>         <row>           <cell>Sprache, Gespräch und Unterhaltung</cell>           <cell rendition="#right">192</cell>         </row>         <row>           <cell>Wetten, Vielliebchen und Geschenke überhaupt</cell>           <cell rendition="#right">207</cell>         </row>         <row>           <cell>Ehrenangelegenheiten</cell>           <cell rendition="#right">216</cell>         </row>         <row>           <cell>Konventionelle Lügen</cell>           <cell rendition="#right">222</cell>         </row>       </table>         <milestone rendition="#hr" unit="section"/><lb/>
</div>
