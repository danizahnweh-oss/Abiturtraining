<docImprint><hi rendition="#b"><hi rendition="#sup">ro</hi> 22.</hi><pubPlace><hi rendition="#c"><hi rendition="#g">Hattingen,</hi></hi></pubPlace><docDate> Sonnabend, den 16. März <hi rendition="#b #fr #right">1850.</hi></docDate>            </docImprint></titlePage><lb/>
