<titlePage type="main"> <docTitle> <titlePart type="main"> <hi rendition="#b">Aus meinem Leben</hi><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<hi rendition="#g">Dichtung und Wahrheit</hi>.<lb/>
</titlePart> </docTitle> <byline> <hi rendition="#g">Von</hi><lb/>
