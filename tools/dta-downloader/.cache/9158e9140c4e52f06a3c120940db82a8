<pb facs="#f0002"/>
<pb n="[I]" facs="#f0003"/>
<titlePage type="main"><docTitle><titlePart type="main"><hi rendition="#g">Briefe</hi><lb/>
u&#x0364;ber<lb/>
<hi rendition="#g"><hi rendition="#b">Zu&#x017F;tände und Begebenheiten</hi></hi><lb/>
in der<lb/>
<hi rendition="#g"><hi rendition="#b">Türkei</hi></hi><lb/>
aus<lb/>
<hi rendition="#g">den Jahren 1835 bis 1839</hi>.</titlePart></docTitle><lb/>
<figure/> <milestone unit="section" rendition="#hr"/><lb/>
<docImprint><pubPlace><hi rendition="#b">Berlin, Po&#x017F;en</hi> und <hi rendition="#b">Bromberg</hi>.</pubPlace><lb/>
<publisher>Druck und Verlag von Ern&#x017F;t Siegfried Mittler.</publisher><lb/>
