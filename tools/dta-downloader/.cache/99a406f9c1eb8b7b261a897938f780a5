<text>     <front>
<pb facs="#f0001"/>
<div type="frontispiece"><figure rendition="#aq"><head>BRÜDERCHEN UND SCHWESTERCHEN.</head>       <p><hi rendition="#i">Ludwig Emil Grimm <gap reason="illegible"/></hi></p>       <p>Stahlstich u. Druck v. Carl Mayer in Nu&#x0364;rnberg</p></figure></div>
<pb facs="#f0002"/>
<titlePage type="halftitle"><docTitle><titlePart type="main">Kinder<lb/>
und<lb/>
Haus-Ma&#x0364;rchen</titlePart></docTitle><lb/>
<docImprint rendition="#aq">Lith u Druck bei <publisher>H. Delius</publisher></docImprint></titlePage><lb/>
<pb facs="#f0003"/>
<pb n="[I]" facs="#f0004"/>
<titlePage type="main"><docTitle><titlePart type="main"><hi rendition="#g"><hi rendition="#b">Kinder</hi><lb/>
und<lb/>
<hi rendition="#b">Hausma&#x0364;rchen.</hi></hi></titlePart></docTitle><lb/>
<byline><hi rendition="#g">Gesammelt<lb/>
durch<lb/>
die </hi><docAuthor><hi rendition="#g">Bru&#x0364;der Grimm</hi></docAuthor>.</byline><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="volume"><hi rendition="#g">Erster Band</hi>.</titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="desc"><hi rendition="#g">Grosse Ausgabe</hi>.</titlePart><lb/>
