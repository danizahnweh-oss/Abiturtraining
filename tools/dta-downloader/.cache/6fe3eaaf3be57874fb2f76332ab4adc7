<div n="1" type="jFeuilleton">             <div n="2" type="jArticle">                <head>                   <hi rendition="#b">Ein Ju&#x017F;tiz-Mord.</hi>                </head>                <lb/>
<byline>Kriminal-Novelle von <hi rendition="#b">Robert v. Hagen.</hi>                </byline>                <lb/>
