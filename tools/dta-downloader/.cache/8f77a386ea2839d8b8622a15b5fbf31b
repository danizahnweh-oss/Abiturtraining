<milestone unit="section" rendition="#hr"/>          <lb/>
<div n="1" type="jVarious">             <head>                <hi rendition="#b">Vermi&#x017F;chtes.</hi>             </head>             <lb/>
<div n="2" type="jArticle">                <head>                   <hi rendition="#b">Herab&#x017F;etzung der hohen Kohlentarife der<lb/>
Südbahn.</hi>                </head>                 <p>Der Verband der Indu&#x017F;triellen in den<lb/>
