<div n="1" type="jPoliticalNews">             <head>                <hi rendition="#b">Politi&#x017F;che Nachrichten.</hi>             </head>             <lb/>
<div n="2" type="jArticle">                <head>                   <hi rendition="#b">(Der Battenberger in Wien.)</hi>                </head>                 <p>Aus Wien<lb/>
