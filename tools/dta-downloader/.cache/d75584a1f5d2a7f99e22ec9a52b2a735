<hi rendition="#g"><hi rendition="#b">Buch des Andenkens</hi></hi><lb/>
für ihre<lb/>
<hi rendition="#b"><hi rendition="#red"><hi rendition="#g">Freunde</hi>.</hi></hi></titlePart>         </docTitle>         <lb/>
<epigraph>           <cit>             <quote>               <hi rendition="#right">&#x2014; &#x2014; &#x017F;till und bewegt.</hi>             </quote>             <lb/>
<bibl>               <hi rendition="#right"><hi rendition="#g">Hyperion</hi>.</hi>             </bibl>           </cit>         </epigraph>         <lb/>
