<titlePage type="heading" xml:id="title2" prev="#title1">             <docImprint>                <docDate>                   <hi rendition="#b">Nr. 4. Mittwoch den 12. Jänner 1898. 18. Jahrg.</hi>                </docDate>             </docImprint>             <lb/>
