<castItem><role xml:id="RAM"><hi rendition="#fr">Ramu&#x017F;in,</hi> japane&#x017F;i&#x017F;cher Ge&#x017F;andt&#x017F;chafts-Attach<hi rendition="#aq">é</hi>.</role></castItem><lb/>
<castItem><role xml:id="MUR"><hi rendition="#fr">Murray,</hi> ein reicher Amerikaner.</role></castItem><lb/>
