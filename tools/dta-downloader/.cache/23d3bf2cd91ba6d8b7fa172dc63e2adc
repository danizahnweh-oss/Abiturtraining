<epigraph> <quote>&#x1F49; &#x03BC;&#x03B7; &#x03B4;&#x03B1;&#x03C1;&#x03B5;&#x03B9;&#x03C2; &#x03B1;&#x03BD;&#x03D1;&#x03C1;&#x03C9;&#x03C0;&#x03BF;&#x03C2; &#x03BF;&#x03C5; &#x03C0;&#x03B1;&#x03B9;&#x03B4;&#x03B5;&#x03C5;&#x03B5;&#x03C4;&#x03B1;&#x03B9;.<lb/>
