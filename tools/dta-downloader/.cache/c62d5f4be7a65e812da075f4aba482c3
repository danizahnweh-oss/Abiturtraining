<titlePage type="main"><docTitle><titlePart type="main">
Die<lb/>
Weisheit des Brahmanen,</titlePart><lb/>
<titlePart type="sub">ein Lehrgedicht in Bruch&#x017F;tücken.</titlePart></docTitle><lb/>
<byline><hi rendition="#g">Von</hi><lb/>
<docAuthor><hi rendition="#g">Friedrich Rückert</hi>.</docAuthor></byline><lb/>
<titlePart type="volume">Er&#x017F;tes Bändchen.</titlePart><lb/>
<milestone unit="section" rendition="#hr"/>
<docImprint><pubPlace><hi rendition="#g">Leipzig</hi>,</pubPlace><lb/>
