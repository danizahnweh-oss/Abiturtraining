<epigraph>           <cit>             <quote>&#x201E;Ern&#x017F;t i&#x017F;t das Leben, heiter i&#x017F;t die Kun&#x017F;t.&#x201C;</quote>           </cit>         </epigraph>         <lb/>
<figure/>         <lb/>
<milestone unit="section" rendition="#hr"/>         <lb/>
