<pb n="[I]" facs="#f0009"/>
<titlePage type="main"> <docTitle> <titlePart type="main"> <hi rendition="#g">P&#x017F;yche</hi>.<lb/>
</titlePart> <titlePart type="sub">Zur<lb/>
<hi rendition="#g">Entwicklungsge&#x017F;chichte der Seele</hi>.<lb/>
</titlePart> </docTitle> <byline>Von<lb/>
<docAuthor> <hi rendition="#b">Dr. Carl Gu&#x017F;tav Carus,</hi><lb/>
</docAuthor>Geheimen Medicinalrahte, Leibarzte Sr. Maje&#x017F;tät des Königs von Sach&#x017F;en, Ritter des Königl. Säch&#x017F;.<lb/>
Civilverdien&#x017F;torden, des Königl. Preuß. rothen Adlerordens 3. Kl. und des Königl. Belg. St. Leopoldordens,<lb/>
der Akademien von Berlin, Petersburg, Paris, London, Philadelphia, Stockholm, Neapel, Florenz u. &#x017F;. w.<lb/>
Mitgliede.<lb/>
</byline> <milestone unit="section" rendition="#hr"/><lb/>
