<titlePage type="main"><docTitle><titlePart type="main"><hi rendition="#c"><hi rendition="#g">S</hi>ch<hi rendition="#g">reiben<lb/>
an das<lb/>
Publicum.</hi></hi></titlePart><lb/>
<figure/><lb/>
<titlePart type="desc"><hi rendition="#c"><hi rendition="#g">Aus dem Franzo&#x0364;&#x017F;i&#x017F;chen.</hi></hi></titlePart></docTitle><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<docImprint><pubPlace><hi rendition="#c"><hi rendition="#g">BERLIN</hi></hi></pubPlace><lb/>
