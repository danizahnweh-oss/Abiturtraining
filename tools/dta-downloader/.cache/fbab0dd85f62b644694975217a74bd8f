<lb/>
<milestone unit="section" rendition="#hr"/>
<lb/>
<div type="jAn">
<head><hi rendition="#fr">Wir <hi rendition="#fr"><hi rendition="#g">Gu&#x017F;taf</hi></hi> von Gottes Gnaden, der Schweden,
