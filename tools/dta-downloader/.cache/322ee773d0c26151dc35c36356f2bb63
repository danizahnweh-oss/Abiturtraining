<pb facs="#f0004"/>
<titlePage type="main">         <titlePart type="main">Die<lb/>
Sagen und Volksmährchen<lb/>
der<lb/>
Deutschen,</titlePart><lb/>
<byline>von<lb/>
<docAuthor>Friedrich Gottschalck</docAuthor>.</byline><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="series">Erstes Bändchen.</titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
