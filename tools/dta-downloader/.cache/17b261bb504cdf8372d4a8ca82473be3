>                <row>                   <cell>Dienstjahr bei den Pioniren 1818. 1819</cell>                   <cell rendition="#right">                      <ref target="#f0248">240</ref>                   </cell>                </row>                <row>                   <cell>Litteratur und Kunst 1819</cell>                   <cell rendition="#right">                      <ref target="#f0277">269</ref>                   </cell>                </row>                <row>                   <cell>Reise nach Dresden 1819</cell>                   <cell rendition="#right">                      <ref target="#f0291">283</ref>                   </cell>                </row>                <row>                   <cell>Heidelberg 1819. 1820</cell>                   <cell rendition="#right">                      <ref target="#f0313">305</ref>                   </cell>                </row>                <row>                   <cell>München 1820</cell>                   <cell rendition="#right">                      <ref target="#f0351">343</ref>                   </cell>                </row>                <row>                   <cell>Baden 1820</cell>                   <cell rendition="#right">                      <ref target="#f0386">378</ref>                   </cell>                </row>                <row>                   <cell>Löbichau. Berlin. Baireuth 1820</cell>                   <cell rendition="#right">                      <ref target="#f0395">387</ref>                   </cell>                </row>                <row>                   <cell>Paris. Lyon. London 1820. 1821</cell>                   <cell rendition="#right">                      <ref target="#f0420">412</ref>                   </cell>                </row>             </table>
