<pb facs="#f0001"/>
<docTitle><titlePart type="main">Der tiefe Meissner Erbstolln.</titlePart></docTitle><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="sub">Der einzige, den Bergbau der Freyberger Refier für<lb/>
die fernste Zukunft sichernde Betriebsplan,</titlePart><lb/>
<docAuthor><hi rendition="#g">dargelegt<lb/>
von</hi><lb/>
<hi rendition="#i">Siegmund August Wolfgang Freiherr von Herder,</hi><lb/>
Königl. Sächs. Oberberghauptmann.</docAuthor><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="desc">Nebst einer geognostischen Karte, einem Profil- und einem Grund-Risse.</titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<docImprint><pubPlace><hi rendition="#g">Leipzig</hi>:</pubPlace><lb/>
<publisher><hi rendition="#g">F. A. Brockhaus.</hi></publisher><lb/>
