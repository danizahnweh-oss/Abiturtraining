<titlePage type="main">         <docTitle>           <titlePart type="main"><hi rendition="#b"><hi rendition="#g">Ae&#x017F;thetik</hi></hi><lb/>
oder<lb/>
<hi rendition="#b"><hi rendition="#g">Wi&#x017F;&#x017F;en&#x017F;chaft des Scho&#x0364;nen</hi>.</hi></titlePart>           <lb/>
<milestone unit="section" rendition="#hr"/>           <titlePart type="sub">Zum<lb/>
