<cb/>
<div n="1" type="jFinancialNews">             <head>                <hi rendition="#b">Volkswirth&#x017F;chaftlicher Theil.</hi>             </head>             <lb/>
<div n="2" type="jArticle">                <head>                   <hi rendition="#b">Gegen die geplante Transport&#x017F;teuer</hi>                </head>                 <p>hat<lb/>
