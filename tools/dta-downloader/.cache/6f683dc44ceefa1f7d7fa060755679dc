<byline>           <hi rendition="#g">von</hi>           <lb/>
<docAuthor><hi rendition="#g">Franz Grillparzer</hi>.</docAuthor>         </byline>         <lb/>
<milestone unit="section" rendition="#hr"/>         <docImprint>           <pubPlace>             <hi rendition="#g">Wien,</hi>           </pubPlace>           <docDate>             <hi rendition="#g">1819.</hi>           </docDate>           <lb/>
<publisher><hi rendition="#g">Im Verlage bey J. B. Wallishau&#x017F;&#x017F;er</hi>.</publisher>         </docImprint>       </titlePage>       <lb/>
