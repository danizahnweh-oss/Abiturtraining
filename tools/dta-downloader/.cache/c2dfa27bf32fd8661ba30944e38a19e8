<titlePage type="main"> <docTitle> <titlePart type="main"> <hi rendition="#b">Ae&#x017F;theti&#x017F;che Feldzu&#x0364;ge.</hi></titlePart> </docTitle><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<byline> <hi rendition="#g">Dem jungen Deut&#x017F;chland</hi><lb/>
gewidmet<lb/>
von<lb/>
<docAuthor>L. <hi rendition="#g">Wienbarg.</hi></docAuthor> </byline><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
