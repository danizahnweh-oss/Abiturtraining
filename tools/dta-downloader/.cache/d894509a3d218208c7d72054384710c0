<pb facs="#f0001" n="151"/>
<titlePage type="main">             <docTitle>                                  <titlePart type="main">                     <hi rendition="#c">Vermischte Beyträge<lb/>
<hi rendition="#b">zur <hi rendition="#g">Philosophie</hi></hi><lb/>
<hi rendition="#smaller">und den</hi><lb/>
<hi rendition="#b">schönen Wissenschaften.</hi></hi><lb/>
</titlePart>             </docTitle>             <figure/><lb/>
<titlePart type="volume"><hi rendition="#c">Zweyten Bandes, erstes Stück.</hi></titlePart>             <milestone rendition="#hr" unit="section"/>             <docImprint>                 <pubPlace><hi rendition="#g"><hi rendition="#c">Breslau,</hi></hi></pubPlace><lb/>
<publisher>                     <hi rendition="#c">in Verlag Wilhelm Gottlieb Korns und Gamperts.</hi>                 </publisher><lb/>
