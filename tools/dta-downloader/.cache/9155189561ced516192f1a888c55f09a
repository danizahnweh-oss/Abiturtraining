<front>      <space dim="vertical"/>       <titlePage type="main">                 <docAuthor><hi rendition="#c #g">W. Alexis</hi></docAuthor>                 <docTitle>                 <titlePart type="main">                     <hi rendition="#c #g #larger">ge&#x017F;ammelte Novellen.</hi><lb/>
