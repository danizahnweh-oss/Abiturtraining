&#x03B1;&#x1FBD;&#x03C5;&#x03C4;&#x03BF;&#x1FE6;, &#x1F23;&#x03BD; &#x1F10;&#x03BD;&#x03AE;&#x03C1;&#x03B3;&#x03B7;&#x03C3;&#x03B5;&#x03BD; <hi rendition="#aq">&amp;c.</hi> Da er nun ha&#x0364;tte &#x017F;agen<lb/>
