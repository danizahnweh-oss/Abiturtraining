<titlePage type="main"> <docTitle> <titlePart type="main"><hi rendition="#aq #k">Fausts<lb/>
Leben, Thaten</hi><lb/>
<hi rendition="#i">und</hi><lb/>
<hi rendition="#aq #k">Höllenfahrt</hi><lb/>
<hi rendition="#i">in fünf Büchern</hi>.</titlePart></docTitle><lb/>
<figure/><lb/>
