<titlePage type="main">         <docTitle>             <titlePart type="main"> <hi rendition="#g">Die<lb/>
<hi rendition="#b">Kindermo&#x0364;rderinn</hi></hi></titlePart>     <lb/>
<titlePart type="sub"><hi rendition="#g">ein<lb/>
<hi rendition="#b">Trauer&#x017F;piel.</hi></hi></titlePart></docTitle><lb/>
