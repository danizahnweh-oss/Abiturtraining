<titlePage type="main">         <docTitle>           <titlePart type="main">             <hi rendition="#b">Voll&#x017F;ta&#x0364;ndiger Lehrbegriff<lb/>
<hi rendition="#g">der<lb/>
ho&#x0364;hern Analy&#x017F;is</hi></hi>           </titlePart>         </docTitle>         <lb/>
<byline><hi rendition="#g">von</hi><lb/>
<docAuthor><hi rendition="#b"><hi rendition="#g">Johann Tobias Mayer</hi>,</hi></docAuthor><lb/>
