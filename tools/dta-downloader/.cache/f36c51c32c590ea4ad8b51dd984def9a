<milestone unit="section" rendition="#hr"/>
<pb n="293[291]" facs="#f0301"/>
<div n="2">           <head>17.<lb/>
Walter Lovell an Eduard Burton.</head>           <lb/>
<dateline>             <hi rendition="#et">London.</hi>           </dateline>           <lb/>
<p><hi rendition="#in">I</hi>ch &#x017F;chreibe Ihnen in einer großen Verlegen-<lb/>
