<titlePage type="main">
<docTitle>
<titlePart type="main">Der Frauen Natur und Recht.</titlePart><lb/>
<milestone rendition="#hr" unit="section"/><lb/>
<titlePart type="sub">Zur Frauenfrage.</titlePart><lb/>
<milestone rendition="#hr" unit="section"/><lb/>
<titlePart type="desc">Zwei Abhandlungen<lb/>
<hi rendition="#smaller">über</hi><lb/>
Eigenschaften und Stimmrecht der Frauen<lb/>
</titlePart>
</docTitle>
<byline><hi rendition="#smaller">von</hi><lb/>
<persName ref="http://d-nb.info/gnd/11852643X">Hedwig Dohm</persName>.<lb/>
<hi rendition="#smaller">Verfasserin von &#x201E;Jesuitismus im Hausstande&#x201F; und &#x201E;wissenschaftliche Emancipation<lb/>
der Frau.&#x201F;</hi><lb/>
</byline>
<space dim="vertical"/>
<milestone rendition="#hr" unit="section"/><lb/>
<docImprint>
<pubPlace>Berlin.</pubPlace><lb/>
