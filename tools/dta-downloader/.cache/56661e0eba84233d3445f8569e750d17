<titlePage type="main"><docTitle><titlePart type="main"><hi rendition="#b"><hi rendition="#g">Der Prophet.</hi></hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="sub">Hi&#x017F;tori&#x017F;cher Roman<lb/>
aus der Neuzeit Nord-Amerikas.</titlePart></docTitle><lb/>
<byline><hi rendition="#g">Von</hi><lb/>
<docAuthor><hi rendition="#g"><hi rendition="#b">Amalie Schoppe</hi></hi><lb/>
geb. <hi rendition="#g">Wei&#x017F;e.</hi></docAuthor></byline><lb/>
<titlePart type="volume"><hi rendition="#g"><hi rendition="#fr">Dritter Theil.</hi></hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
