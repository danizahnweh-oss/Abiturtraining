<titlePage type="main"> <docTitle> <titlePart type="main"> <hi rendition="#g">Anton Rei&#x017F;er</hi>.</titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="sub"> <hi rendition="#g">Ein<lb/>
p&#x017F;ychologi&#x017F;cher Roman</hi>.</titlePart> </docTitle><lb/>
<figure/> <byline>Herausgegeben<lb/>
<hi rendition="#g">von</hi><lb/>
