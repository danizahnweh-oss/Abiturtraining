<titlePage type="main"><docTitle><titlePart type="main"><hi rendition="#b">Die Innere Verwaltung.</hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/> <titlePart type="sub">Zweites Hauptgebiet.<lb/>
<hi rendition="#b">Das Bildungswe&#x017F;en.</hi><lb/>
<hi rendition="#g">Er&#x017F;ter Theil</hi>.<lb/>
<hi rendition="#b">Das Elementar- und das Berufsbildungswe&#x017F;en</hi><lb/>
in<lb/>
Deut&#x017F;chland, England, Frankreich und andern Ländern.</titlePart></docTitle><lb/>
<byline>Von<lb/>
<docAuthor><hi rendition="#b"><hi rendition="#aq">Dr.</hi> Lorenz Stein.</hi></docAuthor></byline><lb/>
<milestone unit="section" rendition="#hr"/> <docImprint><pubPlace><hi rendition="#b">Stuttgart.</hi></pubPlace><lb/>
<publisher>Verlag der J. G. Cotta&#x2019;&#x017F;chen Buchhandlung.</publisher><lb/>
<docDate><hi rendition="#b">1868.</hi></docDate></docImprint></titlePage><lb/>
