<titlePage type="main"><docTitle><titlePart type="main"><hi rendition="#b">Die Horen</hi></titlePart><lb/>
<titlePart type="sub"><hi rendition="#g">eine Monats&#x017F;chrift</hi></titlePart></docTitle><lb/>
