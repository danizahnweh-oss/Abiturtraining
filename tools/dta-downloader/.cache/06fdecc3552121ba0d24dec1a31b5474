<pb n="99" facs="#f0103" xml:id="pb099_0001"/>
zeugt haben<note place="foot" anchored="true" n="*)"> <p><hi rendition="#k">Pechlin</hi> und <hi rendition="#k">Tulp</hi>  haben dergleichen<lb/>
