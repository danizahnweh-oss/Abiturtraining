<div n="1" type="index">
<pb n="[A1]" facs="#f0733" xml:id="pb709_0001"/>
<head rendition="#c">
<hi rendition="#g">Register</hi>.</head><lb/>
<list>
<item>
<cb/>
<label>A.</label>
<list>
<item>Aal <ref target="#pb265_0001">265</ref>
<list>
<item>&#x2014; Bock <ref target="#pb284_0001">284</ref>
</item>
<item>&#x2014; Mutter <ref target="#pb271_0001">271</ref>
</item>
