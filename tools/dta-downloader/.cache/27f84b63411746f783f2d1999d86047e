<fw type="catch" place="bottom">und</fw><lb/>
<note place="foot" n="16" xml:id="seg2pn_6_2" prev="#seg2pn_6_1"><hi rendition="#aq">Semper et infirmi e&#x017F;t animi, exiguique voluptas<lb/>
