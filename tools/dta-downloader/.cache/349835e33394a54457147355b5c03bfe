von<lb/>
<docAuthor> <hi rendition="#b"><hi rendition="#aq">M.</hi></hi> <hi rendition="#fr">Johann Albrecht Burk.</hi><lb/>
</docAuthor> </byline> <milestone unit="section" rendition="#hr"/><lb/>
<imprimatur>Mit Cen&#x017F;ur<lb/>
der hochwu&#x0364;rdigen theologi&#x017F;chen Fakulta&#x0364;t.</imprimatur><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<docImprint rendition="#g"> <pubPlace><hi rendition="#fr">Tu&#x0364;bingen,</hi></pubPlace><lb/>
