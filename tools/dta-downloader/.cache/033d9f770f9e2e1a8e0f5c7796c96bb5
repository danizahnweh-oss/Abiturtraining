<titlePage type="heading">         <docDate><hi rendition="#aq">Ao</hi>. 1740. <figure/> <hi rendition="#aq">No. XXXVIII.</hi><lb/>
<hi rendition="#fr">Sonnabend, <figure/> den 24. September.</hi></docDate><lb/>
<milestone rendition="#hr" unit="section"/><lb/>
<docTitle><titlePart type="main">           <hi rendition="#fr">Berlinische Nachrichten<lb/>
