<lg type="poem"><head><hi rendition="#b"><hi rendition="#g">Der Abend.</hi></hi></head><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<lg n="1"><head><hi rendition="#c"><hi rendition="#fr">Arie.</hi></hi></head><lb/>
