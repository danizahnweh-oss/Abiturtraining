<fw type="catch" place="bottom"><hi rendition="#fr">Und</hi></fw><lb/>
<pb n="254" facs="#f0262"/>
<fw type="header" place="top">Mu&#x017F;ikali&#x017F;che Gedichte.</fw><lb/>
