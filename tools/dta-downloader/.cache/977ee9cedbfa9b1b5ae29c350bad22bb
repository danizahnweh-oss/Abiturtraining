<fw type="catch" place="bottom"><hi rendition="#fr">Jauchzt</hi></fw><lb/>
<pb n="256" facs="#f0264"/>
<fw type="header" place="top">Mu&#x017F;ikali&#x017F;che Gedichte.</fw><lb/>
<l><hi rendition="#fr">Jauchzt ihm voll Ehrfurcht, dunkle</hi></l><lb/>
