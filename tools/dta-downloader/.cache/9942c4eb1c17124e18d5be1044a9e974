<pb n="201" facs="#f0231"/>
<fw place="top" type="pageNum">201<lb/>
</fw><p><hi rendition="#c"><hi rendition="#aq">c)</hi> <hi rendition="#g">Le&#x017F;en der mu&#x017F;tergültigen volksthüm¬<lb/>
