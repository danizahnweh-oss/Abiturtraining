<formula notation="TeX">\overset{1}{3\frac{1}{3}}+\overset{2}{3\frac{5}{6}}+\overset{3}{4\frac{1}{3}}+\overset{4}{4\frac{5}{6}}+\overset{5}{5\frac{1}{3}}+\overset{6}{5\frac{5}{6}}+\overset{7}{6\frac{1}{3}}+\overset{8}{6\frac{5}{6}}+\overset{9}{7\frac{1}{3}}+</formula><lb/>
