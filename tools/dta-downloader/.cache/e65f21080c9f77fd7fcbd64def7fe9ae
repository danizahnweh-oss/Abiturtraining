<hi rendition="#aq">m</hi> = 1 und <hi rendition="#aq">n</hi> = - 2, &#x017F;o wird <hi rendition="#aq">x</hi> = - 5, oder <hi rendition="#aq">x</hi> = + 5<lb/>
