<list><item><hi rendition="#aq">I. x</hi> - 3 = 1 oder <hi rendition="#aq">x</hi> = 4, &#x017F;o wird <hi rendition="#aq">y + x</hi> + 1<lb/>
<hi rendition="#et">= <hi rendition="#aq">y</hi> + 5 = 26; und <hi rendition="#aq">y</hi> = 21</hi></item><lb/>
<item><hi rendition="#aq">II. x</hi> - 3 = 2 oder <hi rendition="#aq">x</hi> = 5, all&#x017F;o <hi rendition="#aq">y + x</hi> + 1<lb/>
<hi rendition="#et">= <hi rendition="#aq">y</hi> + 6 = 13; und <hi rendition="#aq">y</hi> = 7</hi></item><lb/>
<item><hi rendition="#aq">III. x</hi> - 3 = 13 oder <hi rendition="#aq">x</hi> = 16, &#x017F;o wird <hi rendition="#aq">y + x</hi> + 1<lb/>
