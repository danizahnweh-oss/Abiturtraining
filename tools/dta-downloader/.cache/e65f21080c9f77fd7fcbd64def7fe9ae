<list><item><hi rendition="#aq">I.)</hi> wann <hi rendition="#aq">x</hi> = 1 &#x017F;o kommt 1 - 1 - 6 = - 6.</item><lb/>
<item><hi rendition="#aq">II.)</hi> wann <hi rendition="#aq">x</hi> = 2 &#x017F;o kommt 8 - 2 - 6 = 0.</item><lb/>
<item><hi rendition="#aq">III.)</hi> wann <hi rendition="#aq">x</hi> = 3 &#x017F;o kommt 27 - 3 - 6 = 18.</item><lb/>
