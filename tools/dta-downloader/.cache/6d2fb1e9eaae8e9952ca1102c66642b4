<front>       <titlePage type="main">         <docTitle>           <titlePart type="main">             <hi rendition="#c"><hi rendition="#smaller">Der</hi><lb/>
<hi rendition="#c #larger">Juh&#x017F;chrei auf der Hal&#x017F;eralm.</hi><lb/>
Novelle<lb/>
<hi rendition="#g">aus dem bayeri&#x017F;chen Gebrigslande</hi></hi><lb/>
</titlePart>         </docTitle><lb/>
<byline>           <hi rendition="#c"><hi rendition="#g">von</hi></hi><lb/>
<docAuthor><hi rendition="#c #fr">Maria Arndts.</hi></docAuthor>         </byline><lb/>
<milestone rendition="#hr" unit="section"/><lb/>
