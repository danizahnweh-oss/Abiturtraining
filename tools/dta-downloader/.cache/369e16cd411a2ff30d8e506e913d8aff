<titlePage type="main"> <docTitle> <titlePart type="main">Gedichte</titlePart> </docTitle><lb/>
<byline>von<lb/>
<docAuthor>Ludewig Heinrich Chri&#x017F;toph<lb/>
Hölty.</docAuthor> </byline><lb/>
<milestone unit="section" rendition="#hr"/> <titlePart type="desc">Be&#x017F;orgt durch &#x017F;eine Freunde<lb/>
Friederich Leopold Grafen zu Stolberg<lb/>
und<lb/>
Johann Heinrich Vo&#x017F;s.</titlePart><lb/>
<milestone unit="section" rendition="#hr"/> <docImprint> <pubPlace>Hamburg,</pubPlace> <publisher>bei Carl Ern&#x017F;t Bohn.</publisher><lb/>
