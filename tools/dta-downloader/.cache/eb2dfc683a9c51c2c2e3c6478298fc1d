<div n="1" type="jSupplement">  <floatingText><front> <titlePage type="heading"><docTitle><titlePart type="main"><hi rendition="#b">Außerordentliche Beilage zur Allgemeinen Zeitung</hi></titlePart></docTitle></titlePage><docImprint><docDate>vom 20 März 1848.</docDate></docImprint></front><lb/>
