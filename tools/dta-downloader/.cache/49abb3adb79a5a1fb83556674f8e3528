<hi rendition="#g">bey</hi> <publisher><hi rendition="#g">Chri&#x017F;tian Friedrich Voß</hi>,</publisher> <docDate><hi rendition="#g">1779</hi>.</docDate></docImprint></titlePage><lb/>
