<titlePage type="halftitle"><docTitle><titlePart type="main"><hi rendition="#b">Die Verwaltungslehre.</hi></titlePart></docTitle><lb/>
<byline>Von<lb/>
<docAuthor><hi rendition="#b"><hi rendition="#aq">Dr.</hi> Lorenz Stein.</hi></docAuthor></byline><lb/>
