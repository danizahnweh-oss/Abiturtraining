<titlePage type="main"><docTitle><titlePart type="main"><hi rendition="#b">Innere Verwaltungslehre.</hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/> <titlePart type="sub">Zweites Hauptgebiet. Zweiter Theil.<lb/>
<hi rendition="#b">Die Allgemeine Bildung</hi><lb/>
und<lb/>
<hi rendition="#b">Die Pre&#x017F;&#x017F;e.</hi></titlePart></docTitle><lb/>
<byline>Von<lb/>
<docAuthor><hi rendition="#b"><hi rendition="#aq">Dr.</hi> Lorenz Stein.</hi></docAuthor></byline><lb/>
<milestone unit="section" rendition="#hr"/> <docImprint><pubPlace><hi rendition="#b">Stuttgart.</hi></pubPlace><lb/>
