<fw type="catch" place="bottom">ho-</fw><lb/>
<pb n="432" facs="#f0452"/>
<fw type="header" place="top">(<hi rendition="#aq">III.</hi> Th.) <hi rendition="#b">Von den &#x017F;icheren Mitteln,</hi></fw><lb/>
