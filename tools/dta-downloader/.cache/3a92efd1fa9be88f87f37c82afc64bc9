<pb facs="#f0003"/>
<titlePage type="main">         <titlePart type="main">Die<lb/>
in der Liebe<lb/>
herum&#x017F;chweifende<lb/>
oder<lb/>
be&#x017F;trafte<lb/>
Untreue,</titlePart><lb/>
<byline>be&#x017F;chrieben<lb/>
von<lb/>
der Frau von <hi rendition="#aq">D.</hi></byline><lb/>
<figure/><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<docImprint><hi rendition="#aq">Anno</hi> <docDate><hi rendition="#aq">1763.</hi></docDate></docImprint><lb/>
</titlePage>
