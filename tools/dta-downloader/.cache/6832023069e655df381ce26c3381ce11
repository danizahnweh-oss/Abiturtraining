<titlePage type="heading" xml:id="title2" prev="#title1">             <docImprint>                <docDate>                   <hi rendition="#b">Nr. 91. Mittwoch den 11. November 1896. 16. Jahrg.</hi>                </docDate>             </docImprint>             <lb/>
