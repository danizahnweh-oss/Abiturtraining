<hi rendition="#et">ru&#x0364;hret?</hi><lb/>
<fw type="catch" place="bottom">J&#x017F;t</fw><lb/>
<pb n="73" facs="#f0087"/>
<fw type="header" place="top"><hi rendition="#b">ein Trauer&#x017F;piel.</hi></fw><lb/>
