<fw type="sig" place="bottom">E 5</fw><fw type="catch" place="bottom">Geruhig</fw><lb/>
<pb n="74" facs="#f0088"/>
<fw type="header" place="top"><hi rendition="#b">Canut,</hi></fw><lb/>
