<fw type="header" place="top">Die Knollen- und Wurzelfrüchte.</fw>               <lb/>
<cb/>
<list>                 <item>Möhrenblattlaus (<hi rendition="#aq">Aphis dauci Curtis.</hi>),<lb/>
nicht &#x017F;chädlich.</item>                 <lb/>
<item>                   <hi rendition="#c">Blüthe:</hi>                 </item>                 <lb/>
<item>Möhren&#x017F;chabe (<hi rendition="#aq">Haemylis daucella Hb.</hi>),<lb/>
