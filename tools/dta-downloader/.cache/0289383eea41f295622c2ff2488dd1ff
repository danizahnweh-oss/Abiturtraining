<pb n="368" facs="#f0390" xml:id="pb368_0001"/>
<p rendition="#indent-2">2. &#x2020;. <hi rendition="#i"><hi rendition="#aq">Capreae</hi></hi>. <hi rendition="#aq">T. salicis</hi>.</p>
