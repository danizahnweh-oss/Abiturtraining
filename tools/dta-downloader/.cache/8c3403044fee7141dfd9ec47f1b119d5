<titlePage type="main">         <docTitle>           <titlePart type="main">             <hi rendition="#b">               <hi rendition="#g">Neue<lb/>
Rei&#x017F;e durch Jtalien</hi>             </hi>           </titlePart>         </docTitle>         <lb/>
<byline>           <hi rendition="#g">von</hi>           <lb/>
<docAuthor><hi rendition="#g">Friedrich Schulz</hi>.</docAuthor>         </byline>         <lb/>
<milestone unit="section" rendition="#hr"/>         <titlePart type="volume"><hi rendition="#g"><hi rendition="#b">Er&#x017F;ter Band.</hi><lb/>
