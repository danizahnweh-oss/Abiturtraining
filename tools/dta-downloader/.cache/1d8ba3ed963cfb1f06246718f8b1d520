<p rendition="#et"><hi rendition="#larger">10 Druf uf de Mutter, weil sie jung ist.</hi> (<hi rendition="#i">Schreiberhau.</hi>)</p>                <lb/>
</div>             <div n="2" type="lexiconEntry">                <head><hi rendition="#b">Draufgehen.</hi></head>                <lb/>
