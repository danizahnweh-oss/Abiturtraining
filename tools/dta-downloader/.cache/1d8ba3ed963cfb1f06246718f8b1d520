<pb facs="#f0180" n="[168]"/>
<cb n="335"/>
<p rendition="#et"><hi rendition="#larger">14 Wohlfeil kostet viel Geld.</hi> &#x2013; <hi rendition="#i">Körte, 6928; Körte<hi rendition="#sup">2</hi>, 8670; Stürenburg, 421; Simrock, 11751.</hi></p>                <lb/>
