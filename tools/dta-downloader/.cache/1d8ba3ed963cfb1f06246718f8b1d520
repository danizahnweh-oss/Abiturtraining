</div>             <div n="2" type="lexiconEntry">                <head><hi rendition="#b">Aufspinnen.</hi></head>                <lb/>
<p rendition="#et"><hi rendition="#larger">* Er hat aufgespunnen.</hi> &#x2013; <hi rendition="#i">Schottel, 1125<hi rendition="#sup">a</hi>.</hi></p>                <lb/>
</div>             <div n="2" type="lexiconEntry">                <head><hi rendition="#b">Aufspringen.</hi></head>                <lb/>
