<p rendition="#et2"><hi rendition="#i">Lat.</hi>: Tota erras via. (<hi rendition="#i">Hauer, Kij.</hi>)</p>                <lb/>
</div>
<pb facs="#f0569" n="[557]"/>
<cb n="1113"/>
<div n="2" type="lexiconEntry">                <head><hi rendition="#b">Danebensetzen.</hi></head>                <lb/>
