<p rendition="#et"><hi rendition="#larger">117 Vor Lichtmess Lerchengesang macht um den Lenz mich bang.</hi> &#x2013; <hi rendition="#i">Payne, 17.</hi></p>                <lb/>
<p rendition="#et"><hi rendition="#larger">118 Wenn es um Lichtmess kalt, kommt der Frühling bald.</hi> &#x2013; <hi rendition="#i">Weckstimmen, I.</hi></p>                <lb/>
<p rendition="#et"><hi rendition="#larger">119 Zu Lichtmessen soll man die Wurst bei Tag essen.</hi> &#x2013; <hi rendition="#i">Wunderlich, 22.</hi></p>                <lb/>
<p rendition="#et"><hi rendition="#larger">*120 Es ist Lichtmess im Geldbeutel.</hi> (<hi rendition="#i">Oderbruch.</hi>) &#x2013; <hi rendition="#i">Engelien, 222, 149.</hi></p>                <lb/>
</div>             <div n="2" type="lexiconEntry">                <head><hi rendition="#b">Liebäugeln.</hi></head>                <lb/>
