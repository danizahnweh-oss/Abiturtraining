<pb facs="#f0001"/>
<titlePage type="heading">           <docTitle>             <titlePart type="main">               <hi rendition="#b #c #fr">Märkische Blätter.</hi></titlePart><lb/>
<titlePart type="sub"><hi rendition="#b #c #g">Wochenblatt</hi><lb/>
<milestone rendition="#hr" unit="section"/><lb/>
<hi rendition="#c">für belehrende und angenehme Unterhaltung.</hi></titlePart>           </docTitle><lb/>
