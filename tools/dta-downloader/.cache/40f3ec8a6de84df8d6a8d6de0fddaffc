<pb facs="#f0001"/>
<lb/>
<titlePage type="main"><docTitle><titlePart type="main"><hi rendition="#b">Bericht</hi><lb/>
über die<lb/>
<hi rendition="#g">zur Bekanntmachung geeigneten<lb/>
<hi rendition="#b">Verhandlungen</hi></hi><lb/>
der Königl. Preu&#x017F;s. Akademie der Wissenschaften<lb/>
