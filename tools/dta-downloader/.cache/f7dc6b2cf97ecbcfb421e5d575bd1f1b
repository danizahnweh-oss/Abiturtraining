b</hi> : &#x221E;<hi rendition="#aq">a</hi> : &#x221E;<hi rendition="#aq">c</hi> findet &#x017F;ich öfter. Selten <hi rendition="#aq">v =<lb/>
a : b</hi> : &#x2155;<hi rendition="#aq">c</hi>, <hi rendition="#aq">o = a : b</hi> : ½<hi rendition="#aq">c</hi>, <hi rendition="#aq">x = b</hi> : &#x2153;<hi rendition="#aq">c</hi> : &#x221E;<hi rendition="#aq">a</hi>,<lb/>
