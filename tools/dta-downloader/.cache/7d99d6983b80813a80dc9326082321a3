<div n="2"><head><hi rendition="#b">Per&#x017F;onen.</hi></head><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<castList> <castItem><role xml:id="GERST"><hi rendition="#g">Ger&#x017F;tenzucker,</hi></role> <roleDesc>Profe&#x017F;&#x017F;or und berühmter Rei&#x017F;ender.</roleDesc></castItem><lb/>
