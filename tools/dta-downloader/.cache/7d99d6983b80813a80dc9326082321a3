<div n="2"><head><hi rendition="#b"><hi rendition="#g">Per&#x017F;onen.</hi></hi></head><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<castList> <castItem><role xml:id="STO"><hi rendition="#g">Stop&#x017F;elberger,</hi></role><roleDesc>Ga&#x017F;twirth zum &#x201E;rothen Rößl.&#x201F;</roleDesc></castItem><lb/>
<castItem><role xml:id="NANN"><hi rendition="#g">Nanni,</hi></role> <roleDesc>de&#x017F;&#x017F;en Tochter.</roleDesc></castItem><lb/>
<castItem><role xml:id="HAN"><hi rendition="#g">Hans,</hi></role><roleDesc>Lenzelsbauern&#x017F;ohn.</roleDesc></castItem><lb/>
<castItem><role xml:id="ZWIE"><hi rendition="#aq">Dr.</hi> <hi rendition="#g">Zwiebelmaier,</hi></role><roleDesc>Gelehrter und Profe&#x017F;&#x017F;or.</roleDesc></castItem><lb/>
<castItem><role xml:id="CASPE"><hi rendition="#g">Casperl Larifari,</hi></role></castItem><lb/>
<castItem><role xml:id="HIE"><hi rendition="#g">Hiesl,</hi></role><roleDesc>in Stop&#x017F;elbergers Dien&#x017F;ten.</roleDesc></castItem><lb/>
<castItem><role xml:id="NAC"><hi rendition="#g">Nachtwächter.</hi></role></castItem><lb/>
<castItem><role xml:id="DOR">Dorfbewohner.</role></castItem><lb/>
<castItem><role xml:id="SCHL"><hi rendition="#g">Schluwi,</hi></role> <roleDesc>Häuptling der Leuwut&#x017F;chen,</roleDesc></castItem><lb/>
<castItem><role xml:id="MIL"><hi rendition="#g">Milipi,</hi></role> <roleDesc>&#x017F;eine Tochter.</roleDesc></castItem><lb/>
<castItem><role xml:id="HAL"><hi rendition="#g">Halamilari,</hi></role><roleDesc>Staatsrath und Adjutant,</roleDesc></castItem><lb/>
<castItem><role xml:id="LEUW">Eingeborne Leuwut&#x017F;chen,</role></castItem><lb/>
