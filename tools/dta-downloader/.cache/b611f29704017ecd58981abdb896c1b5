<front><titlePage type="main"> <docTitle> <titlePart type="main"><hi rendition="#in">L</hi>ebens-<hi rendition="#in">B</hi>e&#x017F;chreibung<lb/>
<hi rendition="#b"><hi rendition="#in">H</hi>errn <hi rendition="#in">W</hi>olffgang<lb/>
<hi rendition="#in">E</hi>ulenbecks,</hi></titlePart><lb/>
<titlePart type="sub">Der Rechten Doctoris, und Chur-Sa&#x0364;ch-<lb/>
&#x017F;i&#x017F;chen wohlverdienten Hof-Raths.</titlePart><lb/>
<milestone rendition="#hr" unit="section"/><lb/>
<titlePart type="desc">Zugleich werden<lb/>
<hi rendition="#b"><hi rendition="#in">A</hi>lle hohe <hi rendition="#in">G</hi>o&#x0364;nner, <hi rendition="#in">P</hi>atronen<lb/>
und <hi rendition="#in">F</hi>reunde,</hi><lb/>
Den 29. April 1740.<lb/>
Jn der Schule zum heiligen Creutz<lb/>
<hi rendition="#b"><hi rendition="#in">E</hi>inige <hi rendition="#in">A</hi>b&#x017F;chieds-<hi rendition="#in">R</hi>eden</hi><lb/>
geneigt anzuho&#x0364;ren,<lb/>
gehor&#x017F;am&#x017F;t er&#x017F;ucht,<lb/>
von<lb/>
<hi rendition="#b"><hi rendition="#in">C</hi>hri&#x017F;tian <hi rendition="#in">S</hi>cho&#x0364;ttgen,</hi><lb/>
Rector.</titlePart></docTitle><lb/>
<milestone rendition="#hr" unit="section"/><lb/>
