<closer><dateline>Den 26&#x017F;ten October 1812.</dateline>                             <lb/>
<signed>                                 <hi rendition="#et"><hi rendition="#fr">Zadich</hi> <hi rendition="#aq">et</hi> <hi rendition="#fr">Wollheim,</hi><lb/>
