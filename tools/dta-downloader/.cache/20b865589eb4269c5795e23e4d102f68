<castList>         <head>           <hi rendition="#c"><hi rendition="#g">Per&#x017F;onen</hi>.</hi>         </head>         <lb/>
<milestone unit="section" rendition="#hr"/>         <castItem>           <role xml:id="KOENIG">König <hi rendition="#g">Andreas</hi> von Ungarn.</role>         </castItem>         <lb/>
<castItem>           <role xml:id="GER"><hi rendition="#g">Gertrude</hi>, &#x017F;eine Gemahlin.</role>         </castItem>         <lb/>
<castItem>           <role xml:id="BEL"><hi rendition="#g">Bela</hi>, Beider Kind.</role>         </castItem>         <lb/>
<castItem>           <role xml:id="OTTO">Herzog <hi rendition="#g">Otto</hi> von <hi rendition="#g">Meran</hi>, der Königin Bruder.</role>         </castItem>         <lb/>
