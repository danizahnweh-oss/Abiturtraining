<castItem>           <role xml:id="ERN"><hi rendition="#g">Erny</hi>, &#x017F;eine Frau.</role>         </castItem>         <lb/>
<castItem>           <role xml:id="SIMON">Graf <hi rendition="#g">Simon</hi>, Bruder des Bancbanus.</role>         </castItem>         <lb/>
<castItem>           <role xml:id="GRA">Graf <hi rendition="#g">Peter</hi>, Erny&#x2019;s Bruder.</role>         </castItem>         <lb/>
<castItem>           <role xml:id="HAUPT">Der <hi rendition="#g">Hauptmann</hi> des königlichen Schlo&#x017F;&#x017F;es.</role>         </castItem>         <lb/>
<castItem>           <role xml:id="GEFOLGEOTTO">Zwei <hi rendition="#g">Edelleute</hi> von Herzog Otto&#x2019;s Gefolge.</role>         </castItem>         <lb/>
