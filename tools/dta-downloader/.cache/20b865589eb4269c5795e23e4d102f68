<castItem>           <role xml:id="KAEMR">Ein königlicher <hi rendition="#g">Kämmerer</hi>.</role>         </castItem>         <lb/>
<castItem>           <role xml:id="ARZT">Ein <hi rendition="#g">Arzt</hi>.</role>         </castItem>         <lb/>
