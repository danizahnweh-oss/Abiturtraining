<titlePage type="main"><docTitle><titlePart type="main"> <hi rendition="#b">Das Reich der Erfindungen.</hi></titlePart></docTitle><lb/>
<milestone unit="section" rendition="#hr"/> <byline><hi rendition="#g">Herausgegeben</hi><lb/>
von<lb/>
<docAuthor><hi rendition="#b"><hi rendition="#g"><hi rendition="#aq">Dr.</hi> Heinrich Samter</hi></hi></docAuthor><lb/>
unter Mitwirkung von<lb/>
<hi rendition="#b">Regierungsrat Max Geitel, <hi rendition="#aq">Dr.</hi> Franz Kalckhoff, <hi rendition="#aq">Dr.</hi> Otto Lubar&#x017F;ch,<lb/>
<hi rendition="#aq">Dr.</hi> Fritz Plato, Direktor Max Speer, <hi rendition="#aq">Dr.</hi> Hans Stadthagen,<lb/>
<hi rendition="#aq">Dr.</hi> Max Weitz und A&#x017F;tronom Gu&#x017F;tav Witt.</hi></byline><lb/>
<milestone unit="section" rendition="#hr"/> <titlePart type="volume">In einem Band komplett.</titlePart><lb/>
<milestone unit="section" rendition="#hr"/> <titlePart type="desc"><hi rendition="#b">Mit 534 Abbildungen.</hi></titlePart><lb/>
