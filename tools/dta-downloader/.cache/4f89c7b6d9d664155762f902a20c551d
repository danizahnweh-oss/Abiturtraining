<pb facs="#f0001"/>
<titlePage type="main"> <lb/>
<docTitle><titlePart type="main"><hi rendition="#b">Archiv für Landeskunde</hi><lb/>
der<lb/>
<hi rendition="#b"><hi rendition="#fr">Preußi&#x017F;chen Monarchie.</hi></hi></titlePart></docTitle><lb/>
