</div>                          <div type="jArticle" xml:id="ar008b" corresp="ar008a" xml:lang="fra">                     <dateline>                         <hi rendition="#aq #c"><hi rendition="#i">Brest,</hi> le 9                         Octobre.</hi></dateline>                 <lb/>
