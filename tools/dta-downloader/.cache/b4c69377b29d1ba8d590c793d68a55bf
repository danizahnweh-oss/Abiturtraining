<pb n="[II]" facs="#f0008"/>
<titlePage type="halftitle"><docTitle><titlePart type="main"> <hi rendition="#b">Deut&#x017F;ches Leben.</hi></titlePart><lb/>
<titlePart type="sub">Eine Sammlung abge&#x017F;chlo&#x017F;&#x017F;ener Schilderungen<lb/>
aus der<lb/>
<hi rendition="#b">deut&#x017F;chen Ge&#x017F;chichte</hi><lb/>
mit be&#x017F;onderer Berück&#x017F;ichtigung der Culturge&#x017F;chichte und der Beziehungen zur<lb/>
Gegenwart.</titlePart><lb/>
<titlePart type="volume"><hi rendition="#g">Er&#x017F;ter Band</hi>.<lb/>
<hi rendition="#b">Die deut&#x017F;che Trachten- und Modenwelt.</hi></titlePart></docTitle><lb/>
<milestone unit="section" rendition="#hr"/> <docImprint><pubPlace><hi rendition="#b">Leipzig,</hi></pubPlace><lb/>
<publisher><hi rendition="#g">Verlag von Gu&#x017F;tav Mayer</hi>.</publisher><lb/>
