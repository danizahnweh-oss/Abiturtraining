<pb n="211" facs="#f0223"/>
<milestone unit="section" rendition="#hr"/> <div n="1"><head><hi rendition="#b"><hi rendition="#g">Zweyter Theil</hi>.</hi><lb/>
<milestone unit="section" rendition="#hr"/> <hi rendition="#g">Ge&#x017F;chichte des Rechts<lb/>
im<lb/>
