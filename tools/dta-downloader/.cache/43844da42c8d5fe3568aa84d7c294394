<docImprint>N<hi rendition="#sup">ro</hi> 46. <space dim="horizontal"/>             <pubPlace><hi rendition="#c"><hi rendition="#g">Bremen,</hi></hi></pubPlace> <docDate><hi rendition="#g">8. Juni</hi><space dim="horizontal"/>               <hi rendition="#right">1852.</hi> </docDate></docImprint></titlePage><lb/>
