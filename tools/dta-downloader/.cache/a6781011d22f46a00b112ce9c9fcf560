<titlePage type="heading" xml:id="tb02" prev="#tb01"><docImprint><hi rendition="#b"><hi rendition="#sup">ro</hi> 74.</hi><pubPlace><hi rendition="#c"><hi rendition="#g">Hattingen,</hi></hi></pubPlace><docDate> Mittwoch, den 14. September <hi rendition="#b #fr #right">1852.</hi></docDate>          </docImprint></titlePage><lb/>
