<div n="1" type="jLocal">             <head>                <hi rendition="#b">Vereinsnachrichten.</hi>             </head>             <lb/>
<div n="2" type="jArticle">                <head>                   <hi rendition="#b">§ Katholi&#x017F;cher Schulverein.</hi>                </head>                 <p>In der Ausbreitung<lb/>
