<titlePage type="main"> <docTitle>     <titlePart type="main"><hi rendition="#g">Die</hi><lb/>
<hi rendition="#b">Elixiere des Teufels.</hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="sub"><hi rendition="#g">Nachgela&#x017F;&#x017F;ene Papiere<lb/>
des Bruders Medardus<lb/>
eines Capuziners</hi>.</titlePart> </docTitle><lb/>
<byline><hi rendition="#g">Herausgegeben</hi><lb/>
von dem Verfa&#x017F;&#x017F;er der Fanta&#x017F;ie&#x017F;tu&#x0364;cke in<lb/>
Callots Manier.</byline><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
