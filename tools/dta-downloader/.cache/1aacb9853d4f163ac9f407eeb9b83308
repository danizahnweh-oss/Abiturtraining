<titlePage type="heading" xml:id="title2" prev="#title1">             <docImprint>                <docDate>                   <hi rendition="#b">Nr. 199. Olmütz, Dienstag den 1. September 1891. 12. Jahrgang.</hi>                </docDate>             </docImprint>          </titlePage>          <lb/>
