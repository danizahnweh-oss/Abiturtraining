<item><hi rendition="#aq"><hi rendition="#g">Nevis-yeneps,</hi> seven pence.</hi></item><lb/>
<item><hi rendition="#aq"><hi rendition="#g">Teaich</hi></hi> oder <hi rendition="#aq"><hi rendition="#g">Theg-yeneps,</hi> eight pence.</hi></item><lb/>
