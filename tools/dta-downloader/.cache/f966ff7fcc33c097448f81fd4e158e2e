<titlePage type="heading">             <docTitle>               <titlePart type="main"><hi rendition="#fr">Das Heller=Blatt</hi></titlePart><lb/>
<titlePart type="sub"><hi rendition="#c #g">oder</hi><lb/>
<hi rendition="#c #fr">Magazin zur Verbreitung gemeinnütziger Kenntnisse.</hi>               </titlePart></docTitle><lb/>
