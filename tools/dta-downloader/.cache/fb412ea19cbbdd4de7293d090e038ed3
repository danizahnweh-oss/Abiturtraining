<fw type="sig" place="bottom">C c 2</fw><fw type="catch" place="bottom">mein</fw><lb/>
<pb n="404" facs="#f0410"/>
<milestone unit="section" rendition="#hr"/><lb/>
mein Herr, und ihr alle Zweifel benehmen.<lb/>
