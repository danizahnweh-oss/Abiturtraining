<closer><dateline>Greifswald, den 9ten Sept. 1812.</dateline>                                     <lb/>
<signed>                                         <hi rendition="#et"><hi rendition="#fr">Ko&#x0364;nigl.                                                 Hofgericht hie&#x017F;elb&#x017F;t.</hi></hi>                                     </signed></closer>                             </div>                 <lb/>
<milestone unit="section" rendition="#hr"/>                 <lb/>
<div type="jAn">                                 <head><hi rendition="#c"><hi rendition="#fr">Oe&#x017F;&#x017F;entlicher Verkauf eines Platzes mit                                             darauf<lb/>
&#x017F;tehendem Geba&#x0364;ude.</hi>                                     <lb/>
