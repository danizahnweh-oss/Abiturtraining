<div type="jArticle" xml:id="ar005b" corresp="ar005a" xml:lang="fra">                     <dateline>                         <hi rendition="#aq #c"><hi rendition="#i">Amsterdam,</hi> le 3                         Octobre.</hi></dateline>                     <lb/>
