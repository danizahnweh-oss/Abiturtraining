<row><cell rows="1" cols="1"><hi rendition="#aq">Diana</hi>,</cell>           <cell rows="1" cols="1">-</cell>           <cell rows="1" cols="1"><hi rendition="#aq">C. H. Fechter</hi>,</cell>           <cell rows="1" cols="1">-</cell>           <cell rows="1" cols="1">1.</cell>           <cell rows="1" cols="1">  Juli.   </cell>         </row>        <lb/>
