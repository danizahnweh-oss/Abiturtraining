<milestone unit="section" rendition="#hr"/>     <castList><castItem><role xml:id="KAIS"><hi rendition="#g">Der Kai&#x017F;er</hi>.</role></castItem><lb/>
<castItem><role xml:id="ERZ"><hi rendition="#g">Gebhardt</hi>, Erzbi&#x017F;choff von Worms.</role></castItem><lb/>
