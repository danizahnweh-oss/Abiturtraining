<docTitle><titlePart type="main" xml:id="tpm2" prev="#tpm1"> <hi rendition="#aq">Nr</hi>. 131. </titlePart></docTitle>  <docDate><hi rendition="#c">Würzburg, Samstag den 1. Juni.</hi> <hi rendition="#right">1850.</hi></docDate>   <lb/>
