<pb n="[3]" facs="#f0009"/>
<titlePage type="main"> <byline><hi rendition="#b">Frank Wedekind</hi></byline><lb/>
<milestone unit="section" rendition="#hr"/> <docTitle><titlePart type="main"><hi rendition="#b"><hi rendition="#g">Der Erdgei&#x017F;t</hi></hi></titlePart><lb/>
<titlePart type="sub">Eine Tragödie</titlePart></docTitle><lb/>
