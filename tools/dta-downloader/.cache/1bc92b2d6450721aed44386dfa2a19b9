<titlePage type="main"><docTitle><titlePart type="main"> <hi rendition="#g"><hi rendition="#b">Das We&#x017F;en</hi><lb/>
des<lb/>
<hi rendition="#b">Chri&#x017F;tenthums</hi></hi></titlePart></docTitle><lb/>
<byline><hi rendition="#g">von</hi><lb/>
<docAuthor><hi rendition="#b">Ludwig Feuerbach.</hi></docAuthor></byline><lb/>
<milestone unit="section" rendition="#hr"/> <docImprint><pubPlace><hi rendition="#g"><hi rendition="#b">Leipzig:</hi></hi></pubPlace><lb/>
<publisher><hi rendition="#g">Otto Wigand</hi>.</publisher><lb/>
