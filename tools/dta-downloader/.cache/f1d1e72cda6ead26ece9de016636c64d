<pb facs="#f0008"/>
<pb facs="#f0009"/>
<titlePage type="main"> <docTitle> <titlePart type="main"> <hi rendition="#b">Ruhe i&#x017F;t die er&#x017F;te Bürgerpflicht</hi><lb/>
<hi rendition="#g">oder</hi><lb/>
<hi rendition="#b">Vor fünfzig Jahren.</hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="sub"> Vaterländi&#x017F;cher Roman</titlePart> </docTitle><lb/>
<byline> von<lb/>
<docAuthor> <hi rendition="#b">W. Alexis (W. Häring).</hi></docAuthor> </byline> <milestone unit="section" rendition="#hr"/><lb/>
<lb/>
<titlePart type="volume"> <hi rendition="#g">Er&#x017F;ter Band.</hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
