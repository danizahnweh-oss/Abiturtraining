<titlePage type="main">                 <docTitle>                     <titlePart type="main">Börne&#x2019;s Leben.</titlePart><lb/>
</docTitle>                 <milestone rendition="#hr" unit="section"/>                 <byline>Von<lb/>
<docAuthor><hi rendition="#b">Karl Gutzkow</hi></docAuthor>.</byline><lb/>
<milestone rendition="#hr" unit="section"/>                 <byline>Mit <hi rendition="#g">Börne&#x2019;s</hi> Bildniß in Stahl gestochen und einem Facsimile.</byline><lb/>
<milestone rendition="#hr" unit="section"/>                 <docImprint>                     <pubPlace>Hamburg</pubPlace>.<lb/>
