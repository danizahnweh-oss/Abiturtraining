<div type="jArticle" xml:id="ar008b" corresp="ar008a" xml:lang="fra">                             <dateline>                                 <hi rendition="#aq #c"><hi rendition="#i">Copenhague</hi>, le 29                                     Septembre.</hi>                             </dateline>                             <lb/>
<p><hi rendition="#aq">Une nouvelle frégate, nommée la Venus,<lb/>
