<docImprint><hi rendition="#b"><hi rendition="#sup">ro</hi> 5.</hi><pubPlace><hi rendition="#c"><hi rendition="#g">Hattingen,</hi></hi></pubPlace><docDate> Mittwoch, den 16. Januar           <hi rendition="#b #fr #right">1850.</hi></docDate>          </docImprint></titlePage><lb/>
