<fw type="catch" place="bottom">die</fw><lb/>
<pb n="32" facs="#f0036"/>
die <hi rendition="#fr">Per&#x017F;on</hi> &#x017F;ondern die <hi rendition="#fr">Heurath</hi> die du verab&#x017F;cheu-<lb/>
