<docTitle><titlePart type="main" xml:id="tpm2" prev="#tpm1"><hi rendition="#aq">Nr</hi>. 192. </titlePart></docTitle>  <docDate><hi rendition="#c">Würzburg, Montag den 12. August.</hi> <hi rendition="#right">1850.</hi> </docDate>  <lb/>
