<front><titlePage type="heading"><docDate><hi rendition="#b">Nr. 91.</hi></docDate> <docTitle><titlePart type="main"><hi rendition="#b">Morgenblatt.</hi></titlePart></docTitle> <docDate><hi rendition="#b">103. Jahrgang. München, Dien&#x017F;tag,</hi> 3. April 1900.</docDate></titlePage><lb/>
