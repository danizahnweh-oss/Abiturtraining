<div n="1"><floatingText><front><titlePage type="heading"><docDate><hi rendition="#b">Dien&#x017F;tag,</hi></docDate> <docTitle><titlePart type="main"><hi rendition="#b">Zweites Morgenblatt Nr. 91 der Allgemeinen Zeitung.</hi></titlePart></docTitle> <docDate>3. April 1900.</docDate></titlePage></front><lb/>
