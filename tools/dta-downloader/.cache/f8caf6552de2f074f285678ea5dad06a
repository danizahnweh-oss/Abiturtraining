nur wie ein Achtel, und ein Achtel<lb/>
<fw type="catch" place="bottom">nur</fw><lb/>
<pb facs="#f0277"/>
<cb n="513"/>
<fw type="header" place="top"><hi rendition="#b"><hi rendition="#g">Det</hi></hi></fw><lb/>
