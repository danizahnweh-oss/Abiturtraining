der Wind gar auf die Ro&#x0364;hren,<lb/>
<fw type="sig" place="bottom">F 5</fw><fw type="catch" place="bottom">und</fw><lb/>
<pb facs="#f0110"/>
<cb n="179"/>
<fw type="header" place="top"><hi rendition="#b"><hi rendition="#g">Bla</hi></hi></fw><lb/>
