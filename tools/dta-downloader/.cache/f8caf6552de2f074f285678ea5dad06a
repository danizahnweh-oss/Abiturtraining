<fw type="sig" place="bottom"><hi rendition="#fr">Ritter-</hi><hi rendition="#aq"><hi rendition="#i">Lexic.</hi></hi> E</fw><fw type="catch" place="bottom">ren</fw><lb/>
<pb facs="#f0086"/>
