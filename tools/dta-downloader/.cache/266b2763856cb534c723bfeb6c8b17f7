<titlePage type="heading" xml:id="title2" prev="#title1">             <docImprint>                <docDate>                   <hi rendition="#b">Nr. 91. Mittwoch, den 14. November 1900. 20. Jahrg.</hi>                </docDate>             </docImprint>             <lb/>
