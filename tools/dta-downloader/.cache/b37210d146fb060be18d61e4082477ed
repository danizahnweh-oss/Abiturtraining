<titlePage type="main">                 <titlePart type="main"><hi rendition="#b">Rußland wie es wirklich ist!</hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/>                 <titlePart type="sub">Der 17. Jahrestag<lb/>
<hi rendition="#b"><hi rendition="#g">der<lb/>
Polnischen Revolution</hi>.</hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/>                 <titlePart type="sub"><hi rendition="#b #g">Eine Rede</hi><lb/>
gesprochen in der zu Paris am 29. November 1847<lb/>
zur Feier dieses Jahrestages gehaltenen Versammlung</titlePart><lb/>
<byline><hi rendition="#g">von</hi><lb/>
<docAuthor><hi rendition="#b">M. Bakunin</hi></docAuthor><hi rendition="#b">,</hi><lb/>
<hi rendition="#g">russischem Flüchtling</hi>.</byline><lb/>
<milestone unit="section" rendition="#hr"/>                 <docImprint><hi rendition="#g">Ins Deutsche übertragen</hi>.<lb/>
<milestone unit="section" rendition="#hr"/>                     <pubPlace><hi rendition="#b">Mannheim</hi></pubPlace>.<lb/>
