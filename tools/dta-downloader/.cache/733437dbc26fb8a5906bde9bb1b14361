<pb facs="#f0009"/>
<titlePage type="main">         <docTitle>           <titlePart type="main">             <hi rendition="#b">Goethe's Briefwech&#x017F;el</hi>             <lb/>
<hi rendition="#g">mit</hi>             <lb/>
<hi rendition="#b"><hi rendition="#g">einem Kinde</hi>.</hi>           </titlePart>           <lb/>
<milestone unit="section" rendition="#hr"/>           <titlePart type="sub">             <hi rendition="#b">Seinem Denkmal.</hi>           </titlePart>         </docTitle>         <lb/>
<milestone unit="section" rendition="#hr"/>         <titlePart type="volume">           <hi rendition="#b">Er&#x017F;ter Theil.</hi>         </titlePart>         <lb/>
