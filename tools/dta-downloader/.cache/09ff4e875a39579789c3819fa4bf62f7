<div n="1">     <floatingText>     <front>     <docTitle><titlePart type="main"><hi rendition="#fr">Jntelligenzblatt zur Auswanderungszeitung</hi> N<hi rendition="#sup">ro</hi> 25.</titlePart></docTitle><lb/>
