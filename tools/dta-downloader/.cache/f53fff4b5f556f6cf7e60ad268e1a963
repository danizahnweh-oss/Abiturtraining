<div n="1"><floatingText><front><titlePage type="heading"><docDate><hi rendition="#b">Freitag,</hi></docDate> <docTitle><titlePart type="main"><hi rendition="#b">Zweites Morgenblatt Nr. 87 der Allgemeinen Zeitung.</hi></titlePart></docTitle> <docDate>30. März 1900.</docDate></titlePage></front><lb/>
