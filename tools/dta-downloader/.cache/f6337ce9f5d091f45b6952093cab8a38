<pb n="[V]" facs="#f0011"/>
<titlePage type="series"><docTitle><titlePart type="main">Friedrich Schleiermacher's<lb/>
<hi rendition="#g">&#x017F;a&#x0364;mmtliche Werke</hi>.</titlePart><lb/>
<milestone unit="section" rendition="#hr"/> <titlePart type="volume">Er&#x017F;te Abtheilung.</titlePart><lb/>
<titlePart type="sub"><hi rendition="#g">Zur Theologie</hi>.</titlePart></docTitle><lb/>
