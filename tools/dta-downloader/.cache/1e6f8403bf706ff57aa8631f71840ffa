<l><hi rendition="#et">weben,</hi></l><lb/>
<fw type="sig" place="bottom">Y 3</fw><fw type="catch" place="bottom">Die</fw><lb/>
<pb n="342" facs="#f0358"/>
<fw type="header" place="top">Die mannigfaltige Weisheit GOttes.</fw><lb/>
