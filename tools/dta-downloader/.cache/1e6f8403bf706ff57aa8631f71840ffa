<fw type="sig" place="bottom">S 3</fw><fw type="catch" place="bottom">Wenn</fw><lb/>
<pb n="278" facs="#f0294"/>
<fw type="header" place="top">Die Allmacht GOttes.</fw><lb/>
<lg n="15"><l><hi rendition="#in">W</hi>enn er winkt, &#x017F;o i&#x017F;t das Toben,<lb/>
