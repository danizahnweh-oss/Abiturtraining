<milestone unit="section" rendition="#hr"/>
<pb n="[107]" facs="#f0115"/>
<milestone unit="section" rendition="#hr"/> <div n="2"><head><hi rendition="#b"><hi rendition="#g">Dritter Aufzug</hi>.</hi></head><lb/>
<milestone unit="section" rendition="#hr"/> <div n="3"><head><hi rendition="#g">Er&#x017F;ter Auftritt</hi>.</head><lb/>
<sp who="#PRI"><speaker><hi rendition="#g">Prinze&#x017F;&#x017F;inn</hi></speaker> <stage>allein.</stage><lb/>
<p><hi rendition="#in">W</hi>o bleibt Eleonore? Schmerzlicher<lb/>
