<hi rendition="#g">Vorsitzenden des Zentralausschusses.</hi><lb/>
</titlePart>                 <milestone rendition="#hr" unit="section"/>                 <titlePart type="volume">                     <hi rendition="#b">II. Jahrgang, 1893.</hi><lb/>
</titlePart>                 <milestone rendition="#hr" unit="section"/>                 <docImprint>                     <pubPlace><hi rendition="#b">Leipzig,</hi></pubPlace><lb/>
<publisher><hi rendition="#g">R. Voigtländer&#x2019;s Verlag.</hi></publisher><lb/>
