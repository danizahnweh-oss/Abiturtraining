<text>     <front>
<pb facs="#f0001"/>
<titlePage type="main">           <titlePart type="main">Der Ball der Tiere</titlePart><lb/>
<epigraph>             <lg type="poem">               <l><hi rendition="#red">Treten Sie näher!</hi></l><lb/>
<l><hi rendition="#red">Sagte der Häher.</hi></l><lb/>
</lg>           </epigraph>           <docImprint>             <publisher>C. C. Meinhold &amp; Söhne</publisher> in <pubPlace>Dresden</pubPlace>           </docImprint><lb/>
</titlePage>
<pb facs="#f0002"/>
</front>
<pb facs="#f0003"/>
<body>       <div n="1">         <lg type="poem">           <lg>             <l><hi rendition="#red">Wir geben einen Ball!</hi></l><lb/>
<l>S<hi rendition="#red">agte die</hi> N<hi rendition="#red">achtigall.</hi></l>           </lg><lb/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/4/41/Der_Ball_der_Tiere_01.jpg/250px-Der_Ball_der_Tiere_01.jpg"/><lb/>
<lg>             <l><hi rendition="#red">N</hi><hi rendition="#blue">ichts wär mir lieber!</hi></l><lb/>
<l>Antwortete der Biber.</l>           </lg><lb/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/d/d8/Der_Ball_der_Tiere_02.jpg/250px-Der_Ball_der_Tiere_02.jpg"/><lb/>
<lg>             <l><hi rendition="#red">Was werden wir speisen?</hi></l><lb/>
<l>Schrieen die Meisen.</l>           </lg><lb/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/d/d6/Der_Ball_der_Tiere_03.jpg/250px-Der_Ball_der_Tiere_03.jpg"/><lb/>
<lg>             <l><hi rendition="#red">H</hi><hi rendition="#blue">ammelkeule!</hi></l><lb/>
<l>Sagte die Eule.</l><lb/>
<l><hi rendition="#red">Strudel!</hi></l><lb/>
<l>Bellte der Pudel.</l><lb/>
</lg>
<pb facs="#f0004"/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/f/fe/Der_Ball_der_Tiere_04.jpg/250px-Der_Ball_der_Tiere_04.jpg"/><lb/>
<lg>             <l><hi rendition="#red">F</hi><hi rendition="#blue">leischbrühe!</hi></l><lb/>
<l>Brummten die Kühe.</l><lb/>
<l><hi rendition="#red">Semmel!</hi></l><lb/>
<l>Blökten die Hämmel.</l>           </lg><lb/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/5/55/Der_Ball_der_Tiere_05.jpg/250px-Der_Ball_der_Tiere_05.jpg"/><lb/>
<lg>             <l><hi rendition="#red">M</hi><hi rendition="#blue">accaroni!</hi></l><lb/>
<l>Wieherte der Pony.</l><lb/>
<l><hi rendition="#red">Klops!</hi></l><lb/>
<l>Knurrte der Mops.</l><lb/>
<l><hi rendition="#red">Aber mit Tunke!</hi></l><lb/>
<l>Sagte die Unke.</l>           </lg><lb/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/d/db/Der_Ball_der_Tiere_06.jpg/250px-Der_Ball_der_Tiere_06.jpg"/><lb/>
<lg>             <l><hi rendition="#red">W</hi><hi rendition="#blue">as werden wir trinken?</hi></l><lb/>
<l>Sangen die Finken.</l><lb/>
</lg>
<pb facs="#f0005"/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/4/47/Der_Ball_der_Tiere_07.jpg/250px-Der_Ball_der_Tiere_07.jpg"/><lb/>
<lg>             <l><hi rendition="#red">B</hi><hi rendition="#blue">ier!</hi></l><lb/>
<l>Brüllte der Stier.</l><lb/>
<l><hi rendition="#red">Wein!</hi></l><lb/>
<l>Grunzte das Schwein.</l><lb/>
<l><hi rendition="#red">Grogk!</hi></l><lb/>
<l>Meckerte der Bock.</l>           </lg><lb/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/2/2e/Der_Ball_der_Tiere_08.jpg/250px-Der_Ball_der_Tiere_08.jpg"/><lb/>
<lg>             <l><hi rendition="#red">K</hi><hi rendition="#blue">affe!</hi></l><lb/>
<l>Grinste der Affe.</l><lb/>
<l><hi rendition="#red">Ach! Thee!</hi></l><lb/>
<l>Bat das Reh.</l>           </lg><lb/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/5/58/Der_Ball_der_Tiere_09.jpg/250px-Der_Ball_der_Tiere_09.jpg"/><lb/>
<lg>             <l><hi rendition="#red">K</hi><hi rendition="#blue">ardinal!</hi></l><lb/>
<l>Sagte der Aal.</l><lb/>
<l><hi rendition="#red">Chocolade!</hi></l><lb/>
<l>Sagte die Made.</l><lb/>
</lg>
<pb facs="#f0006"/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/5/56/Der_Ball_der_Tiere_10.jpg/250px-Der_Ball_der_Tiere_10.jpg"/><lb/>
<lg>             <l><hi rendition="#red">W</hi><hi rendition="#blue">as kostet&#x2019;s Couvert?</hi></l><lb/>
<l>Fragte das Pferd.</l><lb/>
<l><hi rendition="#red">Einen Zweier!</hi></l><lb/>
<l>Sagte der Reiher.</l><lb/>
<l><hi rendition="#red">Einen Nickel!</hi></l><lb/>
<l>Sagte das Karnickel.</l><lb/>
<l><hi rendition="#red">Eine Krone!</hi></l><lb/>
<l>Sagte die Drone.</l>           </lg><lb/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/e/e0/Der_Ball_der_Tiere_11.jpg/250px-Der_Ball_der_Tiere_11.jpg"/><lb/>
<lg>             <l><hi rendition="#red">W</hi><hi rendition="#blue">en führ&#x2019; ich zu Tisch?</hi></l><lb/>
<l>Fragte ein Fisch.</l><lb/>
<l><hi rendition="#red">Die kleine Sardine!</hi></l><lb/>
<l>Sagte die Biene.</l>           </lg><lb/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/2/2f/Der_Ball_der_Tiere_12.jpg/250px-Der_Ball_der_Tiere_12.jpg"/><lb/>
<lg>             <l><hi rendition="#red">W</hi><hi rendition="#blue">er spielt zum Tanz?</hi></l><lb/>
<l>Fragte die Gans.</l><lb/>
<l><hi rendition="#red">Wir werden blasen!</hi></l><lb/>
<l>Sagten die Hasen.</l><lb/>
<l><hi rendition="#red">Ein Frosch wird quaken!</hi></l><lb/>
<l>Sangen die Schnaken.</l><lb/>
</lg>
<pb facs="#f0007"/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/c/c0/Der_Ball_der_Tiere_13.jpg/250px-Der_Ball_der_Tiere_13.jpg"/><lb/>
<lg>             <l><hi rendition="#red">W</hi><hi rendition="#blue">as werden wir tanzen?</hi></l><lb/>
<l>Fragten die Wanzen.</l>           </lg><lb/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/1/1f/Der_Ball_der_Tiere_14.jpg/250px-Der_Ball_der_Tiere_14.jpg"/><lb/>
<lg>             <l><hi rendition="#red">T</hi><hi rendition="#blue">irolienne!</hi></l><lb/>
<l>Sagte die Henne.</l><lb/>
<l><hi rendition="#red">Galopp!</hi></l><lb/>
<l>Sagte der Wiedehopp.</l>           </lg><lb/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/8/8d/Der_Ball_der_Tiere_15.jpg/250px-Der_Ball_der_Tiere_15.jpg"/><lb/>
<lg>             <l><hi rendition="#red">S</hi><hi rendition="#blue">chottisch!</hi></l><lb/>
<l>Sagte der Pottfisch.</l><lb/>
<l><hi rendition="#red">Menuett!</hi></l><lb/>
<l>Sagte der Sterlett.</l><lb/>
</lg>
<pb facs="#f0008"/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/1/19/Der_Ball_der_Tiere_16.jpg/250px-Der_Ball_der_Tiere_16.jpg"/><lb/>
<lg>                 <l><hi rendition="#red">W</hi><hi rendition="#blue">ie lange?</hi></l><lb/>
<l>Fragte die Schlange.</l><lb/>
<l><hi rendition="#red">Bis Zehne!</hi></l><lb/>
<l>Sagten die Schwäne.</l>           </lg><lb/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/9/9f/Der_Ball_der_Tiere_17.jpg/250px-Der_Ball_der_Tiere_17.jpg"/><lb/>
<lg>             <l><hi rendition="#red">B</hi><hi rendition="#blue">is Zwölfe!</hi></l><lb/>
<l>Heulten die Wölfe.</l>           </lg><lb/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/f/fd/Der_Ball_der_Tiere_18.jpg/250px-Der_Ball_der_Tiere_18.jpg"/><lb/>
<lg>             <l><hi rendition="#red">A</hi><hi rendition="#blue">ber wo?</hi></l><lb/>
<l>Fragte der Floh.</l><lb/>
<l><hi rendition="#red">Im Jägerhaus!</hi></l><lb/>
<l>Sagte die Maus.</l><lb/>
</lg>           <lg>             <l><hi rendition="#red">U</hi><hi rendition="#blue">nd da war das Erzählchen</hi><lb/>
<hi rendition="#et"><hi rendition="#red">aus.</hi></hi></l><lb/>
</lg>
<pb facs="#f0009"/>
<pb facs="#f0010"/>
<lg>             <l><hi rendition="#red">Glühwürmchen</hi></l><lb/>
<l><hi rendition="#red">Leuchtet allen nach Haus.</hi></l>           </lg><lb/>
<figure facs="http://upload.wikimedia.org/wikipedia/commons/thumb/9/9b/Der_Ball_der_Tiere.djvu/page10-500px-Der_Ball_der_Tiere.djvu.jpg"/><lb/>
</lg>       </div>     </body>   </text> </TEI>