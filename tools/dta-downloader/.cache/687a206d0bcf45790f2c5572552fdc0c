<titlePage type="main"><docTitle><titlePart type="main"><hi rendition="#g">Abri&#x017F;s<lb/>
des</hi><lb/>
Systems der Biologie</titlePart></docTitle><lb/>
<byline><hi rendition="#g">von</hi><lb/>
<docAuthor><hi rendition="#g">Dr. Oken</hi>.</docAuthor></byline><lb/>
<titlePart type="desc">Zum Behufe seiner Vorlesungen.</titlePart><lb/>
<milestone unit="section" rendition="#hr"/> <docImprint><pubPlace><hi rendition="#g">Göttingen</hi>,</pubPlace><lb/>
