</div>             <div n="2" type="lexiconEntry">                <head><hi rendition="#b">Schleissen,</hi> s.  Schlîten.</head>                <lb/>
</div>             <div n="2" type="lexiconEntry">                <head><hi rendition="#b">Schleissgasse.</hi></head>                <lb/>
