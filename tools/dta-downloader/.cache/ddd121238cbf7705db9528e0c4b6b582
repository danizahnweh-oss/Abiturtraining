<p rendition="#et"><hi rendition="#larger">*9 Sik strüwen as'n kalkutsken Hahn.</hi> &#x2013; <hi rendition="#i">Eichwald, 699.</hi></p>                <lb/>
</div>             <div n="2" type="lexiconEntry">                <head><hi rendition="#b">Straubinger.</hi></head>                <lb/>
