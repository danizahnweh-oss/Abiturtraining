<pb n="173" facs="#f0183"/>
<fw type="header" place="top"><hi rendition="#g">Zweiter Akt.</hi></fw><lb/>
<sp who="#ALB"><speaker><hi rendition="#g">Alba.</hi></speaker><lb/>
<p><hi rendition="#et">Warum</hi><lb/>
