<pb n="48" facs="#f0058"/>
<fw type="header" place="top"><hi rendition="#g">Dom Karlos</hi>.</fw><lb/>
<sp who="#MAR"><speaker><hi rendition="#g">Marquis</hi></speaker><lb/>
<stage>lebhaft einfallend.</stage><lb/>
<p><hi rendition="#et">Wie? Darf ich mich unter&#x017F;tehen</hi><lb/>
