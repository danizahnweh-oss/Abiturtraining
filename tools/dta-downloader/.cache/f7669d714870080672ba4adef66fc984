<castItem><role xml:id="OLI">Herzoginn von <hi rendition="#g">Olivarez</hi>, Oberhofmei&#x017F;terinn.</role></castItem><lb/>
<castGroup rendition="#rightBraced"><castItem><role xml:id="MOND">Marqui&#x017F;inn von <hi rendition="#g">Mondekar</hi>,</role></castItem><lb/>
