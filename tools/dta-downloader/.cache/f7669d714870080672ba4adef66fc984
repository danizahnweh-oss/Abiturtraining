<castItem><role xml:id="DAMEGRAN"><hi rendition="#g">Mehrere Damen</hi></role> und <role xml:id="GRAN">Granden</role>, <role xml:id="PAGEN">Pagen,</role><lb/>
<role xml:id="OFF">Offiziere, die Leibwache und ver&#x017F;chiedene</role><lb/>
