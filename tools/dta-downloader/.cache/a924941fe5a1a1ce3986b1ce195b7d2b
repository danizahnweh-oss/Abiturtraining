<milestone unit="section" rendition="#hr"/>          <lb/>
<div n="1">             <head>                <hi rendition="#b">Nachtrag.</hi>             </head>             <lb/>
<dateline>                <hi rendition="#g">Olmütz,</hi> 10. September.</dateline>             <lb/>
<div n="2" type="jArticle">                <head>                   <hi rendition="#b">Schadenfeuer in Neuga&#x017F;&#x017F;e.</hi>                </head>                <lb/>
<p>Heute Nachmittags ½1 Uhr i&#x017F;t in der Markt-<lb/>
