<div type="jExpedition">             <head>                <hi rendition="#b">                   <supplied>2</supplied>. Jahrgang.</hi>             </head>             <lb/>
<milestone unit="section" rendition="#hr"/>             <lb/>
<p>                <hi rendition="#b">                   <supplied>Redac</supplied>tion, Admini&#x017F;tration,<lb/>
