<front> <titlePage type="heading"><docTitle><titlePart type="main"><hi rendition="#b">Allgemeine Zeitung.</hi></titlePart><lb/>
<titlePart type="volume"><hi rendition="#b">Nr. 4. </hi></titlePart></docTitle><docImprint><pubPlace><hi rendition="#b">Augsburg,</hi></pubPlace><docDate>Donner&#x017F;tag, 4 Januar 1872.</docDate><lb/>
