<milestone unit="section" rendition="#hr"/>                <lb/>
<div n="3" type="jArticle">                   <dateline>                      <hi rendition="#b">Berlin,</hi> 27. Mai.</dateline>                    <p>Der &#x201E;Nordd. Allg.<lb/>
