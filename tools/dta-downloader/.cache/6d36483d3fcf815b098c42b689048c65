<pb facs="#f0001"/>
<titlePage type="main">         <byline>Denkschrift<lb/>
von<lb/>
<docAuthor>J. G. Tulla</docAuthor>         </byline><lb/>
<docImprint>v. J. <docDate>1822</docDate></docImprint><lb/>
