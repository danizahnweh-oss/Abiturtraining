<titlePage type="main">         <docTitle>           <titlePart type="main">             <hi rendition="#g"><hi rendition="#b">Propa&#x0364;deutik</hi><lb/>
zum Studium der ge&#x017F;ammten<lb/>
<hi rendition="#b">Heilkun&#x017F;t.</hi></hi>           </titlePart>           <lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="sub">Ein Leitfaden akademi&#x017F;cher Vorle&#x017F;ungen,</titlePart>         </docTitle>         <lb/>
<byline><hi rendition="#g">entworfen<lb/>
von</hi><lb/>
<docAuthor><hi rendition="#g">D. K. F. Burdach,</hi></docAuthor><lb/>
<hi rendition="#g">Privatlehrer an der Univer&#x017F;ita&#x0364;t zu Leipzig</hi>.</byline>         <lb/>
