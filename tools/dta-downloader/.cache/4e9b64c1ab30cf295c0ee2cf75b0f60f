<titlePage type="main"> <docTitle><titlePart type="main"><hi rendition="#b"><hi rendition="#g">Joachim Nettelbeck,</hi><lb/>
Bu&#x0364;rger zu Colberg.</hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="sub"><hi rendition="#g">Eine Lebensbe&#x017F;chreibung,</hi></titlePart></docTitle><lb/>
<byline>von ihm &#x017F;elb&#x017F;t aufgezeichnet<lb/>
<hi rendition="#g">und<lb/>
herausgegeben<lb/>
von</hi><lb/>
<docAuthor>J. C. L. <hi rendition="#g">Haken.</hi></docAuthor></byline><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="volume"><hi rendition="#b"><hi rendition="#g">Drittes Ba&#x0364;ndchen.</hi></hi></titlePart><lb/>
<titlePart type="desc"><hi rendition="#g">Mit einem Plane der Gegend um Colberg.</hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<docImprint><pubPlace><hi rendition="#g">Leipzig:</hi></pubPlace><lb/>
