<fw type="sig" place="bottom">K 3</fw><fw type="catch" place="bottom"><hi rendition="#fr">Odoar-</hi></fw><lb/>
<pb n="150" facs="#f0154"/>
<fw type="header" place="top"><hi rendition="#g">Emilia Galotti</hi>.</fw><lb/>
