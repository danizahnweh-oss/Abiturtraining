<row><cell>Roggen</cell><cell>1 &#x2014;</cell><cell>6 &#x2014;</cell></row><lb/>
<row><cell>Große Ger&#x017F;te</cell><cell>&#x2014; &#x2014;</cell><cell>20 &#x2014;</cell></row><lb/>
