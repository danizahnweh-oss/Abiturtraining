<cit><quote><hi rendition="#et">&#x0398;&#x03B5;&#x03C1;&#x03BC;&#x03B7;&#x03BD; &#x1F10;&#x03C0;&#x03B9; &#x03C8;&#x03C5;&#x03C7;&#x03C1;&#x03BF;&#x03B9;&#x03C3;&#x03B9; &#x03BA;&#x03B1;&#x03C1;&#x03B4;&#x03B9;&#x03B1;&#x03BD; &#x1F10;&#x03C7;&#x03B5;&#x03B9;&#x03C2;.</hi></quote></cit><lb/>
