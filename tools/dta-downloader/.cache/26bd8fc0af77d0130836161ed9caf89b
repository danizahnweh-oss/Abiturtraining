<pb n="[2]" facs="#f0040"/>
<div n="2"><head><hi rendition="#b"><hi rendition="#g">Per&#x017F;onen.</hi></hi></head><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<castList>     <castItem><role xml:id="KÜH"><hi rendition="#g">Kühleborn,</hi> ein mächtiger Wa&#x017F;&#x017F;ergei&#x017F;t.</role></castItem><lb/>
<castItem><role xml:id="UND"><hi rendition="#g">Undine,</hi> Nixe.</role></castItem><lb/>
<castItem><role xml:id="HUL">Ritter <hi rendition="#g">Huldbrand</hi> von Ring&#x017F;tetten.</role></castItem><lb/>
<castItem><role xml:id="CASP"><hi rendition="#g">Casperl,</hi> &#x017F;ein Knappe.</role></castItem><lb/>
<castItem><role xml:id="HERZ">Herzog <hi rendition="#g">Heinrich.</hi></role></castItem><lb/>
<castItem><role xml:id="BERT"><hi rendition="#g">Berthalda,</hi> &#x017F;eine Tochter.</role></castItem><lb/>
