<div n="1" type="jVarious">             <head>                <hi rendition="#b">Tagebericht.</hi>             </head>             <lb/>
<div n="2" type="jArticle">                <head>                   <hi rendition="#b">* Vom Hofe.</hi>                </head>                 <p>Der <hi rendition="#g">Kai&#x017F;er,</hi> der &#x017F;ich am 9. d.<lb/>
