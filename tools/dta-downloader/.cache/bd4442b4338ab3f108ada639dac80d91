die Zweige <hi rendition="#aq">N</hi><hi rendition="#sub">1</hi> <hi rendition="#aq">L</hi><hi rendition="#sub">1</hi>, beziehungswei&#x017F;e <hi rendition="#aq">N</hi><hi rendition="#sub">2</hi> <hi rendition="#aq">L</hi><hi rendition="#sub">2</hi> und <hi rendition="#aq">N</hi><hi rendition="#sub">1</hi> <hi rendition="#aq">M</hi><hi rendition="#sub">1</hi>, beziehungswei&#x017F;e <hi rendition="#aq">N</hi><hi rendition="#sub">2</hi> <hi rendition="#aq">M</hi><hi rendition="#sub">2</hi><lb/>
