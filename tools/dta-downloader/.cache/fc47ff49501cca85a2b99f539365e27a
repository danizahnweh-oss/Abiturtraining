<p rendition="#et"><hi rendition="#larger">*3 Me soll'n mit Peärküttel däut scheiten.</hi> (<hi rendition="#i">Sauerland.</hi>)</p>                <lb/>
</div>             <div n="2" type="lexiconEntry">                <head><hi rendition="#b">Pferdelast.</hi></head>                <lb/>
