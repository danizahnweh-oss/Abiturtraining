<div n="2" type="lexiconEntry">                <head><hi rendition="#b">Nidel.</hi></head>                <lb/>
<p rendition="#et"><hi rendition="#larger">* Er nimmt d' Nidel<hi rendition="#sup">1</hi> d'rab.</hi> (<hi rendition="#i">Solothurn.</hi>) &#x2013; <hi rendition="#i">Schild, 89, 359.</hi></p>                <lb/>
