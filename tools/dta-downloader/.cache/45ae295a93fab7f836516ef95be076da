                 <div type="jArticle" xml:id="ar037_014_c">                     <note type="editorial">Edition: <bibl>Friedrich Engels: Italien. 7. Juli 1848. In: MEGA<hi rendition="#sup">2</hi> I/7. S. 277.</bibl></note>                     <head><bibl><author>*</author></bibl> Rom.</head>                     <gap reason="copyright"/>                 </div>
