<pb n="[III]" facs="#f0007"/>
<titlePage type="main"> <docTitle><titlePart type="main"><hi rendition="#b">Die<lb/>
lineale Ausdehnungslehre</hi></titlePart><lb/>
<titlePart type="sub"><hi rendition="#g">ein</hi><lb/>
