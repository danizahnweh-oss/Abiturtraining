<pb n="[3]" facs="#f0007"/>
<castList><head><hi rendition="#c"><hi rendition="#fr">Per&#x017F;onen.</hi></hi></head><lb/>
<castItem><role xml:id="CON">Con&#x017F;tantin, Fu&#x0364;r&#x017F;t von Tarent.</role></castItem><lb/>
<castGroup rendition="#rightBraced"><castItem><role xml:id="JUL">Julius</role></castItem><lb/>
<castItem><role xml:id="GUI">Guido</role></castItem><roleDesc>&#x017F;eine So&#x0364;hne.</roleDesc></castGroup><lb/>
<castItem><role xml:id="ERZ">Erzbi&#x017F;chof von Tarent, &#x017F;ein Bruder.</role></castItem><lb/>
<castItem><role xml:id="CAE">Gra&#x0364;fin Caecilia Nigretti, &#x017F;einer Schwe&#x017F;ter Tochter.</role></castItem><lb/>
<castItem><role xml:id="BLA">Blanka.</role></castItem><lb/>
<castItem><role xml:id="ASP">Graf A&#x017F;permonte, Julius Freund.</role></castItem><lb/>
<castItem><role xml:id="AEB">Aebti&#x017F;&#x017F;in des Ju&#x017F;tinenklo&#x017F;ters.</role></castItem><lb/>
<castItem><role xml:id="ARZ">Arzt.</role></castItem><lb/>
