<pb facs="#f0001"/>
<front>             <titlePage type="main">                 <titlePart type="main">Ueber<lb/>
die bevorstehende Freiheit<lb/>
<hi rendition="#g">der Ehsten und Letten</hi>,</titlePart><lb/>
<byline>von<lb/>
<docAuthor>G. v. <hi rendition="#g">Rennenkampff</hi></docAuthor>.<lb/>
Mitglied der Einführungs-Commission.</byline><lb/>
<milestone rendition="#hr" unit="section"/><lb/>
<imprimatur>Mit Approbation der Allerhöchst verordneten Einführungs-<lb/>
Commission.</imprimatur><lb/>
