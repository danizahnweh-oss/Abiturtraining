<div n="2" type="lexiconEntry">                <head><hi rendition="#b">Distelkraut.</hi></head>                <lb/>
<p rendition="#et"><hi rendition="#larger">Distelkraut ist der rechte Salat für den Esel.</hi> &#x2013; <hi rendition="#i">Sailer, 84.</hi></p>                <lb/>
</div>             <div n="2" type="lexiconEntry">                <head><hi rendition="#b">Dito.</hi></head>                <lb/>
