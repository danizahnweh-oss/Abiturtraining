<table>               <row>                 <cell>er&#x017F;te Nebenv.</cell>                 <cell>zweite Nebenv.</cell>                 <cell>dritte Nebenv.</cell>                 <cell>vierte Nebenv.</cell>                 <cell>fu&#x0364;nfte Nebenv.</cell>               </row>               <lb/>
<row>                 <cell>3 Tenor</cell>                 <cell>1 Discant</cell>                 <cell>1 Discant</cell>                 <cell>4 Baß</cell>                 <cell>4 Baß</cell>               </row>               <lb/>
<row>                 <cell>1 Discant</cell>                 <cell>4 Baß</cell>                 <cell>3 Tenor</cell>                 <cell>1 Discant</cell>                 <cell>3 Tenor</cell>               </row>               <lb/>
<row>                 <cell>4 Baß</cell>                 <cell>3 Tenor</cell>                 <cell>4 Baß</cell>                 <cell>3 Tenor</cell>                 <cell>1 Discant</cell>               </row>               <lb/>
