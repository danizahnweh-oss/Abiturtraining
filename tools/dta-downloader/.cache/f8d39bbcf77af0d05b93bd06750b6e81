<row>                 <cell>1 Discant</cell>                 <cell>1 Discant</cell>                 <cell>2 Alt</cell>                 <cell>4 Baß</cell>                 <cell>2 Alt</cell>               </row>               <lb/>
<row>                 <cell>2 Alt</cell>                 <cell>4 Baß</cell>                 <cell>4 Baß</cell>                 <cell>2 Alt</cell>                 <cell>1 Discant</cell>               </row>               <lb/>
