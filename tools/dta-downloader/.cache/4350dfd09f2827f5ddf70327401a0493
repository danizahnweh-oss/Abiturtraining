<titlePage type="main"><docTitle><titlePart type="main"><hi rendition="#g">Napoleons<lb/>
Ge&#x017F;etzbu</hi>ch.<lb/>
</titlePart><lb/>
<milestone rendition="#hr" unit="section"/><lb/>
<titlePart type="desc"><hi rendition="#smaller #g #c">Einzig officielle Ausgabe fu&#x0364;r das Ko&#x0364;nigreich<lb/>
We&#x017F;tphalen.</hi></titlePart></docTitle><lb/>
<milestone rendition="#hr" unit="section"/><lb/>
<figure/><lb/>
<docImprint><pubPlace><hi rendition="#c #g">Straßburg,</hi></pubPlace><lb/>
<publisher>Gedruckt bey F. G. <hi rendition="#g">Levrault</hi>, Judenga&#x017F;&#x017F;e, Nro 33.</publisher><lb/>
