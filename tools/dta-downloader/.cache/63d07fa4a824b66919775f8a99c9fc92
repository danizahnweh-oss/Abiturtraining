<titlePage type="heading">         <docDate><hi rendition="#aq">Ao</hi>. 1741. <figure/> <hi rendition="#aq">No. LXXXII.</hi><lb/>
<hi rendition="#fr">Dienstag, <figure/> den 11. Julii.</hi></docDate><lb/>
<milestone rendition="#hr" unit="section"/><lb/>
<docTitle><titlePart type="main">           <hi rendition="#fr">Berlinische Nachrichten<lb/>
