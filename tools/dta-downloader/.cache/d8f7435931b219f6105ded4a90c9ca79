<titlePart type="sub"><hi rendition="#g">Der Tragödie zweyter Theil<lb/>
in fünf Acten</hi>.</titlePart>       <milestone rendition="#hr" unit="section"/><lb/>
<titlePart type="desc">(Vollendet im Sommer 1831.)</titlePart>       <fw place="bottom" type="sig">Goethe's Werke. <hi rendition="#aq">XLI.</hi> Bd. 2</fw><lb/>
</titlePage>
<pb facs="#f0014" n="[2]"/>
