<titlePage type="main"> <docTitle> <titlePart type="main"> <hi rendition="#g">Characteri&#x017F;tik</hi><lb/>
der merkwu&#x0364;rdig&#x017F;ten<lb/>
<hi rendition="#b">A&#x017F;iati&#x017F;chen Nationen.</hi><lb/>
</titlePart> </docTitle> <milestone unit="section" rendition="#hr"/><lb/>
<docTitle> <titlePart type="desc"> Concentrirt und hi&#x017F;tori&#x017F;ch richtig<lb/>
darge&#x017F;tellt.<lb/>
</titlePart> </docTitle> <milestone unit="section" rendition="#hr"/><lb/>
