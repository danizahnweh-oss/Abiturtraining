<milestone unit="section" rendition="#hr"/>                 <lb/>
<div type="jAnnouncements">                     <div type="jAn">                         <p><hi rendition="#fr">Einem Wohllöblichen Niedergerichte hat Sr.                                 Joh.<lb/>
