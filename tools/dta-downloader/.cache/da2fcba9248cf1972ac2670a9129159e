<div>                 <floatingText>                     <front>                         <titlePage type="main">                             <docTitle>                                 <titlePart type="main">                                     <hi rendition="#b #c #fr">Beylage zu No. 11. des Hamb.                                         unpartheyi&#x017F;chen Corre&#x017F;pondenten.</hi>                                 </titlePart>                             </docTitle>                             <lb/>
