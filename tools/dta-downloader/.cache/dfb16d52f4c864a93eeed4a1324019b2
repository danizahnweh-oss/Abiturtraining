<titlePage type="main"><byline><docAuthor><hi rendition="#b">Johann George Sulzers</hi></docAuthor></byline><lb/>
<docTitle><titlePart type="main"><hi rendition="#g"><hi rendition="#b">Tagebuch</hi><lb/>
einer</hi><lb/>
<hi rendition="#b">von Berlin nach den mitta&#x0364;glichen La&#x0364;ndern<lb/>
von Europa</hi><lb/>
in den Jahren 1775 und 1776<lb/>
<hi rendition="#b">gethanen Rei&#x017F;e und Ru&#x0364;ckrei&#x017F;e.</hi></titlePart></docTitle><lb/>
<figure/><lb/>
