<pb n="[721]" facs="#f0740"/>
<milestone unit="section" rendition="#hr"/>       <div type="contents">         <head>           <hi rendition="#c">             <hi rendition="#g">Inhalt<lb/>
des<lb/>
er&#x017F;ten Kapitels</hi>           </hi>         </head>         <lb/>
