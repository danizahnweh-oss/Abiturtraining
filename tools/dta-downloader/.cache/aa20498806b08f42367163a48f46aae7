<div type="jArticle" xml:id="ar005b" corresp="ar005a" xml:lang="fra">                     <dateline>                         <hi rendition="#aq #c"><hi rendition="#i">Extrait d&#x2019;une lettre de                                 Varsovie,</hi><lb/>
du 1 Octobre.</hi></dateline>                     <lb/>
<p><hi rendition="#aq">Par un décret royal du 19 Sept. dernier, le<lb/>
comte                             Thadaeus Mostowski, fut nommé mi-<lb/>
