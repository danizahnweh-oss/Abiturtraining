<docTitle><titlePart type="main" xml:id="tpm2" prev="#tpm1"> <hi rendition="#aq">Nr</hi>. 130. </titlePart></docTitle>  <docDate><hi rendition="#c">Würzburg, Freitag den 31. Mai.</hi> <hi rendition="#right">1850.</hi></docDate><lb/>
