<table>       <row><cell cols="2" rendition="#right">Seite</cell></row>       <row><cell>1. Weiße Flamme</cell> <cell rendition="#right"><ref target="#f0007">1</ref></cell></row>       <row><cell>2. Liebesmühen</cell> <cell rendition="#right"><ref target="#f0085">77</ref></cell></row>       <row><cell>3. Der erste Blick hinter die Coulissen</cell> <cell rendition="#right"><ref target="#f0207">199</ref></cell></row>       <row><cell>4. &#x201E;Die Schöpfung&#x201C;</cell> <cell rendition="#right"><ref target="#f0281">273</ref></cell></row>       <row><cell>5. Symbiose</cell> <cell rendition="#right"><ref target="#f0309">301</ref></cell></row>       </table>       <milestone unit="section" rendition="#hr"/><lb/>
