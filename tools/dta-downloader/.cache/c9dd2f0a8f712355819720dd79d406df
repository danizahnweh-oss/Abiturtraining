<list>           <item><hi rendition="#aq">AWQO = I</hi> und <hi rendition="#aq">aq</hi> = 1 oder</item>           <lb/>
<item><hi rendition="#aq">HWRO = II</hi> und <hi rendition="#aq">hr</hi> = 2 oder endlich</item>           <lb/>
