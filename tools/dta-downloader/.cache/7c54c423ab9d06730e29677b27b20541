<floatingText><front><titlePage type="heading"><docDate><hi rendition="#b">Donner&#x017F;tag,</hi></docDate> <docTitle><titlePart type="main"><hi rendition="#b">Zweites Morgenblatt Nr. 86 der Allgemeinen Zeitung.</hi></titlePart></docTitle> <docDate>29. März 1900.</docDate></titlePage></front><body><lb/>
