<fw type="sig" place="bottom">T 4</fw><lb/>
<pb facs="#f0004"/>
<pb facs="#f0005"/>
<titlePage type="main"><docTitle><titlePart type="main"><hi rendition="#b"><hi rendition="#g">P&#x017F;yche</hi></hi><lb/>
oder<lb/>
<hi rendition="#b">Unterhaltungen</hi><lb/>
u&#x0364;ber die<lb/>
<hi rendition="#b"><hi rendition="#g">Seele</hi>.</hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="sub"><hi rendition="#g">Fu&#x0364;r<lb/>
Le&#x017F;er und Le&#x017F;erinnen</hi></titlePart></docTitle><lb/>
<byline>von<lb/>
<docAuthor><hi rendition="#g">J. C. G. Schaumann</hi></docAuthor><lb/>
ordentlichem Lehrer am ko&#x0364;niglichen Pa&#x0364;dagogium<lb/>
zu Halle.</byline><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="volume">Zweyter Theil.</titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
