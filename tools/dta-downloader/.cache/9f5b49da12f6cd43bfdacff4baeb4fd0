<pb n="[3]" facs="#f0009"/>
<titlePage type="main"> <docTitle> <titlePart type="main"> <hi rendition="#g">Phanta&#x017F;ien<lb/>
im<lb/>
Bremer Rathskeller;</hi><lb/>
</titlePart> <titlePart type="sub">ein<lb/>
Herb&#x017F;tge&#x017F;chenk fu&#x0364;r Freunde des Weines<lb/>
</titlePart> </docTitle> <byline>von<lb/>
<docAuthor> <hi rendition="#g">Wilhelm Hauff</hi>.<lb/>
</docAuthor> </byline><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
