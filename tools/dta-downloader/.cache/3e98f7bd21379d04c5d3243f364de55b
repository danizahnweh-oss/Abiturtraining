<milestone unit="section" rendition="#hr"/>                             <lb/>
<div type="jAn">                                 <head><hi rendition="#c #fr">Suhr&#x2019;s opti&#x017F;che                                         Rundgemälde.</hi><lb/>
<hi rendition="#c #g">König&#x017F;traße.</hi><lb/>
