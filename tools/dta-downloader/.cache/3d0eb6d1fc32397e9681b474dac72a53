<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="volume"><hi rendition="#g">Des vierten Bandes<lb/>
er&#x017F;tes Heft.</hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<byline>Herausgegeben<lb/>
<hi rendition="#smaller">von</hi><lb/>
<hi rendition="#g">D. Fr. Albr. Carl Gren</hi>,<lb/>
<hi rendition="#smaller">Profe&#x017F;&#x017F;or zu Halle.</hi></byline><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="desc"><hi rendition="#smaller"><hi rendition="#g">Mit zwey Kupfertafeln.</hi></hi></titlePart><lb/>
