<fw type="sig" place="bottom">L 4</fw><fw type="catch" place="bottom">26) Un-</fw><lb/>
<pb n="168" facs="#f0259"/>
<list xml:id="l07f" prev="#l07e"><head><hi rendition="#right">Lachter, Zoll</hi></head><lb/>
<item>26) Unter &#x017F;olchen &#x017F;tehen die <hi rendition="#fr">Stein-<lb/>
