<fw type="sig" place="bottom">E e</fw><lb/>
<pb n="434" facs="#f0448"/>
3936,<hi rendition="#sub">767</hi> + 1735, welche Zahl von 1277,<hi rendition="#sub">7</hi> nur<lb/>
