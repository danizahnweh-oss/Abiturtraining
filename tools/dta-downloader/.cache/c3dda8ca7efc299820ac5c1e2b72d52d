<milestone unit="section" rendition="#hr"/>           <note place="left">             <hi rendition="#aq">I.</hi>           </note>           <p><hi rendition="#in">D</hi>er <hi rendition="#fr">Tod Carls des</hi> <hi rendition="#aq">VI.</hi> machte &#x017F;chon des-<lb/>
