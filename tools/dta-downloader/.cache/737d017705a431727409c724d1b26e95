<titlePage type="heading" xml:id="tp1a" next="#tp1b">             <docImprint>                <docDate xml:id="dd1a" next="#dd1b">                   <hi rendition="#b">Uznach, Sam&#x017F;tag</hi>                </docDate>                 <hi rendition="#b">N<hi rendition="#sup">o</hi> 96.</hi>                 <docDate xml:id="dd1b" prev="#dd1a">                   <hi rendition="#b">den 2. Dezember 1893.</hi>                </docDate>             </docImprint>             <lb/>
<milestone unit="section" rendition="#hr"/>             <lb/>
<titlePart type="main">                <hi rendition="#b">St. Galler-Volksblatt.</hi>             </titlePart>             <lb/>
