<epigraph><cit><quote>&#x1F6D;&#x03C3;&#x03C0;&#x03B5;&#x03F1; &#x03D1;&#x03B5;&#x1F78;&#x03BD; &#x1F10;&#x03BD; &#x1F00;&#x03BD;&#x03D1;&#x03F1;&#x03CE;&#x03C0;&#x03BF;&#x03B9;&#x03C2; &#x03B5;&#x1F30;&#x03BA;&#x1F78;&#x03C2; &#x03B5;&#x1F36;&#x03BD;&#x03B1;&#x03B9;<lb/>
&#x03C4;&#x1F78;&#x03BD; &#x03C4;&#x03BF;&#x03B9;&#x03BF;&#x1FE6;&#x03C4;&#x03BF;&#x03BD; ..... &#x039A;&#x03B1;&#x03C4;&#x1F70; &#x03B4;&#x1F72; &#x03C4;&#x1FF6;&#x03BD; &#x03C4;&#x03BF;&#x03B9;&#x03BF;&#x03CD;&#x03C4;&#x03C9;&#x03BD;<lb/>
&#x03BF;&#x1F50;&#x03BA; &#x1F14;&#x03C3;&#x03C4;&#x03B9; &#x03BD;&#x03CC;&#x03BC;&#x03BF;&#x03C2;&#x0387; &#x03B1;&#x1F50;&#x03C4;&#x03BF;&#x1F76; &#x03B3;&#x03AC;&#x03F1; &#x03B5;&#x1F30;&#x03C3;&#x03B9; &#x03BD;&#x03CC;&#x03BC;&#x03BF;&#x03C2;.<lb/>
</quote><bibl><hi rendition="#i"><hi rendition="#aq #right">Aristoteles.</hi></hi></bibl></cit></epigraph><lb/>
