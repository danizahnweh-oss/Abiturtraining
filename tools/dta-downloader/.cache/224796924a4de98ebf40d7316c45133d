<milestone unit="section" rendition="#hr"/>         <div n="2">           <head><hi rendition="#g">Meela&#x0364;mmchen</hi>.</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">M</hi>ee La&#x0364;mmchen, mee!</l>               <lb/>
