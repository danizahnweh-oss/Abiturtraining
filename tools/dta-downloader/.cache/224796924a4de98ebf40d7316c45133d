<milestone unit="section" rendition="#hr"/>
<pb n="73" facs="#f0341"/>
<div n="2">           <head><hi rendition="#g">Wenn der Schelm die er&#x017F;ten Ho&#x017F;en anzieht</hi>.</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">Z</hi>immerma&#x0364;ntle, Zimmerma&#x0364;ntle,</l>               <lb/>
