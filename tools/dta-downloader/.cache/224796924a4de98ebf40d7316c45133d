<l>Zu Zucker und Brod,</l>               <lb/>
<l>Verkauf ich mein Bettlein,</l>               <lb/>
<pb n="67" facs="#f0335"/>
<l>Und leg mich aufs Stroh,</l>               <lb/>
<l>Sticht mich keine Feder,</l>               <lb/>
<l>Und beißt mich kein Floh.</l>               <lb/>
<l>Eio popeio.</l>             </lg>           </lg>         </div>         <lb/>
<milestone unit="section" rendition="#hr"/>         <div n="2">           <head>             <hi rendition="#g">Walte Gott Vater!</hi>           </head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">E</hi>ya popeya!</l>               <lb/>
