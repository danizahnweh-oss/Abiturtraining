<l>Mit deinem himmeli&#x017F;chen Schein.</l>             </lg>           </lg>         </div>         <lb/>
<milestone unit="section" rendition="#hr"/>         <div n="2">           <head><hi rendition="#g">Sa&#x0364;manu</hi>.</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">H</hi>ut&#x017F;ch he! hut&#x017F;ch he!</l>               <lb/>
