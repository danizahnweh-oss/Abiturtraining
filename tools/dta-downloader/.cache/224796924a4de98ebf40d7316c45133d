<milestone unit="section" rendition="#hr"/>         <div n="2">           <head><hi rendition="#g">Sonnenlied</hi>.</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">S</hi>onne, Sonne &#x017F;cheine,</l>               <lb/>
<l>Fahr u&#x0364;ber Rheine,</l>               <lb/>
<l>Fahr u&#x0364;bers Glockenhaus,</l>               <lb/>
<l>Gucken drey &#x017F;cho&#x0364;ne Puppen raus,</l>               <lb/>
<l>Eine die &#x017F;pinnt Seiden,</l>               <lb/>
