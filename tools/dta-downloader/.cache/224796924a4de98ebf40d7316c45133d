<milestone unit="section" rendition="#hr"/>
<pb n="68" facs="#f0336"/>
<div n="2">           <head><hi rendition="#g">Zu Bett</hi>.</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">Z</hi>u Bett, zu Bett,</l>               <lb/>
