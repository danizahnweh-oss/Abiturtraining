<milestone unit="section" rendition="#hr"/>
<pb n="72" facs="#f0340"/>
<div n="2">           <head><hi rendition="#g">Beim Spaziergang</hi>.</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">S</hi>teig auf das Bergle,</l>               <lb/>
