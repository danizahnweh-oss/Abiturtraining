<milestone unit="section" rendition="#hr"/>         <div n="2">           <head><hi rendition="#g">Mondliedchen</hi>.</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">W</hi>ie der Mond &#x017F;o &#x017F;cho&#x0364;n &#x017F;cheint,</l>               <lb/>
