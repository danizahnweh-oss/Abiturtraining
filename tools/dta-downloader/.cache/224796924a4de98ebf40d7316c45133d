<milestone unit="section" rendition="#hr"/>
<pb n="69" facs="#f0337"/>
<div n="2">           <head><hi rendition="#g">Morgenlied</hi>.</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">S</hi>teht auf ihr lieben Kinderlein,</l>               <lb/>
<l>Der Morgen&#x017F;tern mit hellem Schein,</l>               <lb/>
