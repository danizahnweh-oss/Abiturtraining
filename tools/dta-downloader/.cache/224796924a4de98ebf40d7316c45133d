<milestone unit="section" rendition="#hr"/>         <div n="2">           <head><hi rendition="#g">Tannebaum</hi>.</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">O</hi> Tannebaum, o Tannebaum!</l>               <lb/>
<l>Du bi&#x017F;t ein edles Reis!</l>               <lb/>
