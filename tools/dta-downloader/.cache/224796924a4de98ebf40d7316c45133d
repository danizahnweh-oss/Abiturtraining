<milestone unit="section" rendition="#hr"/>         <div n="2">           <head><hi rendition="#g">Im Fru&#x0364;hling</hi>, <hi rendition="#g">wenn die Maiglo&#x0364;ckchen<lb/>
la&#x0364;uten</hi>.</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">K</hi>ling, kling Glo&#x0364;ckchen,</l>               <lb/>
