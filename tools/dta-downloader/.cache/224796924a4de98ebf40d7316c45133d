<milestone unit="section" rendition="#hr"/>         <div n="2">           <head><hi rendition="#g">Wiegenlied</hi>.</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">E</hi>io popeio was ra&#x017F;&#x017F;elt im Stroh,</l>               <lb/>
<l>Die Ga&#x0364;nslein gehn barfus,</l>               <lb/>
<l>Und haben keine Schuh,</l>               <lb/>
<l>Der Schu&#x017F;ter hats Leder,</l>               <lb/>
<l>Kein Lei&#x017F;ten dazu,</l>               <lb/>
<l>Kann er den Ga&#x0364;nslein</l>               <lb/>
