<milestone unit="section" rendition="#hr"/>         <div n="2">           <head><hi rendition="#g">Gute Nacht</hi>, <hi rendition="#g">mein Kind</hi>!</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">G</hi>uten Abend, gute Nacht,</l>               <lb/>
