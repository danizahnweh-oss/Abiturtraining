<milestone unit="section" rendition="#hr"/>         <div n="2">           <head><hi rendition="#g">Wenn das Kind etwas nicht gern ißt</hi>.</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">B</hi>um bam beier,</l>               <lb/>
