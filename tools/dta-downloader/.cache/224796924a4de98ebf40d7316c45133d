<milestone unit="section" rendition="#hr"/>         <div n="2">           <head><hi rendition="#g">Ein Popeia etzetera</hi>.</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">E</hi>ia im Sauße,</l>               <lb/>
<l>Zwei Wiegen in einem Hauße,</l>               <lb/>
<pb n="65" facs="#f0333"/>
<l>Soll der Vater nicht werden bang,</l>               <lb/>
<l>Um zwei Wiegen in einem Gang,</l>               <lb/>
<l>Eia im Sau&#x017F;e.</l>             </lg>             <lb/>
<lg n="2">               <l>Eia wiwi!</l>               <lb/>
<l>Wer &#x017F;chla&#x0364;ft heut Nacht bei mir,</l>               <lb/>
