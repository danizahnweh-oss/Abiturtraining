<milestone unit="section" rendition="#hr"/>
<pb n="70" facs="#f0338"/>
<div n="2">           <head><hi rendition="#g">Tanzliedchen im Gru&#x0364;nen</hi>.</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">H</hi>eidelbeeren, Heidelbeeren</l>               <lb/>
