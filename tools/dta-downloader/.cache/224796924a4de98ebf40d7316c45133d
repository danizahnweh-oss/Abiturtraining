<milestone unit="section" rendition="#hr"/>         <div n="2">           <head><hi rendition="#g">An&#x017F;chauungs</hi> - <hi rendition="#g">A B C</hi>.</head>           <lb/>
<lg type="poem">             <lg n="1">               <l><hi rendition="#in">A</hi>, b, ab,</l>               <lb/>
