<div>                     <floatingText>                         <front>                             <titlePage type="main">                                 <docTitle>                                     <titlePart type="sub"><hi rendition="#aq #c">Num. 38</hi></titlePart>                                     <titlePart type="main"><hi rendition="#b #c #fr"><hi rendition="#in">V</hi>erfolg der Holl&#x017F;teini&#x017F;chen <hi rendition="#in">Z</hi>eitung/</hi>                                     </titlePart>                                                                  </docTitle>                                 <lb/>
