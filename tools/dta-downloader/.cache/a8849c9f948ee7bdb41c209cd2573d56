sarum regiones iter habeant, pro cujusque gradu et dignitate ho-<lb/>
nore afficiantur etc.</hi> Der griechi&#x017F;che Text &#x017F;agt: &#x03B4;&#x1FBD; &#x1F61;&#x03C2; &#x1F02;&#x03BD; &#x03BF; &#x1F31; &#x03C0;&#x03F1;&#x03AD;&#x03C3;-<lb/>
&#x03B2;&#x03B5;&#x03B9;&#x03C2; &#x03BA;&#x03B1;&#x1F76;  &#x03BF;&#x1F31; &#x03C4;&#x1FC7; &#x03C4;&#x03B1;&#x03C7; &#x03C5;&#x03C4;&#x1FC6;&#x03C4;&#x03B9; &#x03C7;&#x03F1; &#x03CE;&#x03BC;&#x03B5;&#x03BD;&#x03BF;&#x03B9; &#x03C4; &#x1FF6;&#x03BD; &#x03B4;&#x03B7;&#x03BC;&#x03BF;&#x03C3; &#x03AF;&#x03C9;&#x03BD; &#x1F35;&#x03C0;&#x03C0;&#x03C9; &#x03BD; &#x03C0;&#x03F1;&#x1F78;&#x03C2; &#x03C4;&#x1F70; &#x03C2;<lb/>
&#x1F00;&#x03C0;&#x03B1;&#x03B3;&#x03B3;&#x03B5;&#x03BB; &#x03AF;&#x03B1;&#x03C2; &#x1F41; &#x03BC;&#x1F72;&#x03BD; &#x1F10;&#x03C2; &#x03C4;&#x1F70; &#x1FEC;&#x03C9;&#x03BC; &#x03B1;&#x03AF;&#x03C9;&#x03BD;, &#x1F41; &#x03B4;&#x1FBD; &#x1F10;&#x03C2; &#x03C4;&#x1F70; &#x03A0;&#x03B5;&#x03F1; &#x03C3;&#x1FF6;&#x03BD; &#x1F22;&#x03D1;&#x03B7; &#x1F00; &#x03C6;&#x03B9;-<lb/>
