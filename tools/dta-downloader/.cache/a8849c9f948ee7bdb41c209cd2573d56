<pb n="[I]" facs="#f0006"/>
<titlePage type="main"><docTitle><titlePart type="main"><hi rendition="#fr"><hi rendition="#b">Entwicklungs-Ge&#x017F;chichte</hi></hi><lb/>
der<lb/>
<hi rendition="#fr"><hi rendition="#b">Posten</hi></hi><lb/>
von den<lb/>
<hi rendition="#g">älte&#x017F;ten Zeiten bis zur Gegenwart</hi>,<lb/>
mit be&#x017F;onderer Beziehung auf<lb/>
<hi rendition="#fr"><hi rendition="#b">Deut&#x017F;chland</hi>.</hi></titlePart></docTitle><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<byline>Von<lb/>
<docAuthor><hi rendition="#fr"><hi rendition="#b">Eugen Hartmann</hi></hi></docAuthor>,<lb/>
