<foreign xml:lang="grc">&#x1F10;&#x03C2; &#x03B3;&#x1FC6;&#x03C1;&#x03B1;&#x03C2; &#x1F10;&#x03BE;&#x03B9;&#x03BA;&#x03BF;&#x03BD;&#x03C4;&#x03BF;, &#x03C4;&#x03B5;&#x03BB;&#x03B5;&#x03C3;&#x03B1;&#x03BD;&#x03C4;&#x03B5;&#x03C2;</foreign>. &#x2500; Bey den Deutschen, <lb n="p1c_179.004"/>
