<hi rendition="#b #g">einem Vorwort</hi><lb/>
von<lb/>
<hi rendition="#g">de la Motte Fouqu<hi rendition="#aq">e</hi>´</hi>.</titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
