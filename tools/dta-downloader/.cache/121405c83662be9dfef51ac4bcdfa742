<fw type="catch" place="bottom">48. Die</fw><lb/>
<pb facs="#f0114"/>
<lg n="48"> <head><hi rendition="#c">48.</hi></head><lb/>
<l><hi rendition="#in">D</hi>ie nie erho&#x0364;rte &#x017F;chwa&#x0364;rmerey</l><lb/>
