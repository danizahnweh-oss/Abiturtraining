<fw type="catch" place="bottom">60. Kalif</fw><lb/>
<pb facs="#f0118"/>
<lg n="60"> <head><hi rendition="#c">60.</hi></head><lb/>
<l><hi rendition="#in">K</hi>alif von Bagdad, &#x017F;pricht der Ritter</l><lb/>
