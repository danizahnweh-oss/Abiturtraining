<castItem><role xml:id="LOR"><hi rendition="#g">Lorenz,</hi></role> <roleDesc>ein alter Mann.</roleDesc></castItem><lb/>
<castItem><role xml:id="KLA"><hi rendition="#g">Klaus,</hi></role> <roleDesc>Ein&#x017F;iedler.</roleDesc></castItem><lb/>
