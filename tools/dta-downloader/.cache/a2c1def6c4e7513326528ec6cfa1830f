<hi rendition="#et">berwunden:</hi></l><lb/>
<fw type="sig" place="bottom">E 2</fw><fw type="catch" place="bottom">Doch</fw><lb/>
<pb facs="#f0068" n="68"/>
<fw type="header" place="top">Leichen-<hi rendition="#aq">Carmina.</hi></fw><lb/>
