<titlePage type="main"> <docTitle>     <titlePart type="main"><hi rendition="#g">Ueber<lb/>
den</hi><lb/>
<hi rendition="#b">Umgang mit Men&#x017F;chen.</hi></titlePart> </docTitle><lb/>
<milestone rendition="#hr" unit="section"/>     <byline><hi rendition="#g">Von</hi><lb/>
<docAuthor>A. Freyherrn von Knigge.</docAuthor> </byline><lb/>
<figure/><lb/>
<titlePart type="volume"><hi rendition="#g">In zwey Theilen</hi>.</titlePart><lb/>
<milestone rendition="#hr" unit="section"/> <titlePart type="desc">Mit Churfu&#x0364;r&#x017F;tl. Sa&#x0364;ch&#x017F;i&#x017F;chem Privilegio.</titlePart><lb/>
<milestone rendition="#hr" unit="section"/> <docImprint>     <pubPlace><hi rendition="#g">Hannover</hi>,</pubPlace><lb/>
<publisher>in der Schmidt&#x017F;chen Buchhandlung.</publisher><lb/>
