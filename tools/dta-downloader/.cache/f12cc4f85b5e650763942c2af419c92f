<item>Ja&#x0364;gerlied.<ref> &#x2014; 43</ref></item><lb/>
<item>Lied der &#x017F;chwarzen Ja&#x0364;ger.<ref> &#x2014; 45</ref></item><lb/>
<item>Am Hedwigsbrunnen bei Jauer<ref> &#x2014; 47</ref></item><lb/>
<pb facs="#f0012"/>
<item>Letzter Tro&#x017F;t.<ref> Seite 48</ref></item><lb/>
<item>Bundeslied vor der Schlacht.<ref> &#x2014; 51</ref></item><lb/>
<item>Gebet wa&#x0364;hrend der Schlacht.<ref> &#x2014; 55</ref></item><lb/>
<item>Mismuth.<ref> &#x2014; 57</ref></item><lb/>
<item>An den Ko&#x0364;nig.<ref> &#x2014; 59</ref></item><lb/>
<item>Reiterlied.<ref> &#x2014; 60</ref></item><lb/>
<item>Tro&#x017F;t, nach Ab&#x017F;chluß des Waffen&#x017F;till&#x017F;tandes.<ref> &#x2014; 63</ref></item><lb/>
