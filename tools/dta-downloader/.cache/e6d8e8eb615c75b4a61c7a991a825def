<div n="1"><p><floatingText><front><titlePage type="heading"><docDate>Freitag,</docDate> <docTitle><titlePart type="main"><hi rendition="#b">Zweites Morgenblatt, Nr. 344 der Allgemeinen Zeitung.</hi></titlePart></docTitle> <docDate>12. December 1890.</docDate></titlePage></front><lb/>
