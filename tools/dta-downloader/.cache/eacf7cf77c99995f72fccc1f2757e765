<titlePage type="halftitle"><docTitle><titlePart type="main"><hi rendition="#b">Hebbel&#x2019;s<lb/>
<hi rendition="#g">Maria Magdalene</hi>.</hi></titlePart></docTitle><lb/>
<milestone unit="section" rendition="#hr"/></titlePage>
