<titlePart type="sub">             <hi rendition="#g">Alte deut&#x017F;che Lieder</hi>           </titlePart>         </docTitle>         <lb/>
<byline>           <docAuthor>L. Achim v. Arnim. Clemens Brentano.</docAuthor>         </byline>         <milestone rendition="#hr" unit="section"/><lb/>
<lb/>
