<titlePage type="main"> <docTitle>     <titlePart type="main"><hi rendition="#b">Ge&#x017F;präche mit Goethe</hi><lb/>
<hi rendition="#g">in den</hi><lb/>
<hi rendition="#b">letzten Jahren &#x017F;eines Lebens.</hi><lb/>
</titlePart>     <titlePart type="sub"><hi rendition="#b">1823 &#x2014; 1832.</hi></titlePart> </docTitle><lb/>
<milestone unit="section" rendition="#hr"/>     <byline><hi rendition="#g">Von</hi><lb/>
