<milestone unit="section" rendition="#hr"/><lb/>
<div n="2"><head><hi rendition="#b">Zwanzig&#x017F;ter Auftritt.</hi></head><lb/>
<stage><hi rendition="#g">Die Vorigen</hi>, ohne <hi rendition="#g">Weinberl</hi>.</stage><lb/>
<sp who="#SON"><speaker><hi rendition="#g">Sonders</hi>.</speaker><lb/>
