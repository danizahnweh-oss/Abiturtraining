<titlePage type="main">         <docTitle>           <titlePart type="main">             <hi rendition="#b">Italieni&#x017F;che<lb/>
<hi rendition="#g">For&#x017F;chungen</hi></hi>           </titlePart>         </docTitle>         <lb/>
<byline>von<lb/>
<docAuthor><hi rendition="#g"><persName ref="http://d-nb.info/gnd/118987224">C. F. von Rumohr</persName></hi>.</docAuthor></byline>         <lb/>
<milestone unit="section" rendition="#hr"/>         <titlePart type="volume">           <hi rendition="#b"><hi rendition="#g">Zweyter Theil</hi>.</hi>         </titlePart>         <lb/>
<milestone unit="section" rendition="#hr"/>         <docImprint>           <pubPlace>             <hi rendition="#b"><placeName>Berlin</placeName> und <placeName>Stettin</placeName>,</hi>           </pubPlace>           <lb/>
