<milestone unit="section" rendition="#hr"/>           <div n="3">             <head>§ 395.<lb/>
<hi rendition="#aq">A.</hi> <hi rendition="#g">Erwerb der Rechte. &#x2014; Anwendungen</hi>. <hi rendition="#aq">IV.</hi> <hi rendition="#g">Erbrecht.<lb/>
