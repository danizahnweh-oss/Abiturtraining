<text>         <front>
<pb facs="#f0001"/>
<titlePage type="main">                 <titlePart type="main"><hi rendition="#red">Das Konzert der Tiere.</hi></titlePart><lb/>
<figure/><lb/>
</titlePage>
<pb facs="#f0002"/>
</front>
<pb facs="#f0003"/>
<body>             <div n="1">                 <lg>                     <lg n="1">                         <l><hi rendition="#in #red">W</hi><hi rendition="#blue">ir geben ein</hi> <hi rendition="#in #red">K</hi><hi rendition="#blue">onzert!</hi></l><lb/>
<l>Sagte das Nilpferd!</l>                     </lg><lb/>
<lg>                     <l><hi rendition="#in #red">J</hi><hi rendition="#blue">ch mache das Programm!</hi></l><lb/>
<l>Blökte das Lamm.</l><lb/>
<l><hi rendition="#red">Jch dirigiere das Ganze!</hi></l><lb/>
<l>Sprach der Schimpan&#x017F;e.</l>                 </lg><lb/>
<lg>                     <l><hi rendition="#in #red">W</hi><hi rendition="#blue">ir geigen mit den Tatzen!</hi></l><lb/>
<l>Miauten ein paar Katzen.</l><lb/>
<l><hi rendition="#red">Jch &#x017F;piele Cello!</hi></l><lb/>
<l>Knurrte Pudel Bello.</l>                 </lg><lb/>
<pb facs="#f0004"/>
<lg>                     <l><hi rendition="#in #red">D</hi><hi rendition="#blue">er Ton war nicht rein!</hi></l><lb/>
<l>Grunzte das Schwein.</l><lb/>
<l><hi rendition="#red">Was ver&#x017F;teh&#x017F;t denn du?</hi></l><lb/>
<l>Brummte die Kuh.</l>                 </lg><lb/>
<lg>                     <l><hi rendition="#in #red">S</hi><hi rendition="#blue">eid nur hüb&#x017F;ch &#x017F;till!</hi></l><lb/>
<l>Sagte der Mandrill.</l><lb/>
<l><hi rendition="#red">Es i&#x017F;t nicht von Strauß!</hi></l><lb/>
<l>Rief die Fledermaus.</l>                 </lg><lb/>
<lg>                     <l><hi rendition="#in #red">S</hi><hi rendition="#blue">olche Mu&#x017F;ik i&#x017F;t eine Schand'!</hi></l><lb/>
<l>Trompetete der Elefant.</l>                 </lg><lb/>
<pb facs="#f0005"/>
<lg>                     <l><hi rendition="#in #red">J</hi><hi rendition="#blue">ch spiele Klavier!</hi></l><lb/>
<l>Rief das Trampeltier.</l>                 </lg><lb/>
<lg>                     <l><hi rendition="#in #red">W</hi><hi rendition="#blue">ir bla&#x017F;en Flöten!</hi></l><lb/>
<l>Quakten zwei Kröten.</l><lb/>
<l><hi rendition="#red">Jch &#x017F;inge Sopran!</hi></l><lb/>
<l>Sagte der Pelikan.</l>                 </lg><lb/>
<lg>                     <l><hi rendition="#in #red">J</hi><hi rendition="#blue">ch bla&#x017F;' die Po&#x017F;aun!</hi></l><lb/>
<l>Brummte Mei&#x017F;ter Braun.</l><lb/>
<l><hi rendition="#red">Aber bitte in Moll!</hi></l><lb/>
<l>Flötete der Pirol.</l>                 </lg><lb/>
<pb facs="#f0006"/>
<lg>                     <l><hi rendition="#in #red">M</hi><hi rendition="#blue">ir den be&#x017F;ten Platz!</hi></l><lb/>
<l>Rief der freche Spatz.</l><lb/>
<l><hi rendition="#red">Wir können nichts &#x017F;ehen!</hi></l><lb/>
<l>Riefen die Krähen.</l>                 </lg><lb/>
<lg>                     <l><hi rendition="#in #red">N</hi><hi rendition="#blue">un fangt 'mal an!</hi></l><lb/>
<l>Krähte der Hahn.</l><lb/>
<l><hi rendition="#red">Stimmt die Jn&#x017F;trumente!</hi></l><lb/>
<l>Schnatterte die Ente.</l>                 </lg><lb/>
<lg>                     <l><hi rendition="#in #red">S</hi><hi rendition="#blue">ie &#x017F;pielen &#x017F;chon, horch! horch!</hi></l><lb/>
<l>Klapperte der Storch.</l><lb/>
<l><hi rendition="#red">Das wäre mir recht,</hi></l><lb/>
<l>Meinte der Specht.</l>                 </lg><lb/>
<pb facs="#f0007"/>
<lg>                     <l><hi rendition="#in #red">M</hi><hi rendition="#blue">ir kommt &#x017F;ie dumm vor!</hi></l><lb/>
<l>Sprach Mei&#x017F;ter Langohr.</l><lb/>
<l><hi rendition="#red">Keine Spur von Melodei!</hi></l><lb/>
<l>Schrie der Papagei.</l>                 </lg><lb/>
<lg>                     <l><hi rendition="#in #red">M</hi><hi rendition="#blue">ir wird ganz &#x017F;chlecht,</hi></l><lb/>
<l>Sagte der Hecht.</l><lb/>
<l><hi rendition="#red">Au! Au!</hi></l><lb/>
<l>Schrie der Pfau!</l>                 </lg><lb/>
<lg>                     <l><hi rendition="#in #red">J</hi><hi rendition="#blue">ch halt's nicht länger aus!</hi></l><lb/>
<l>Piep&#x017F;te eine kleine Maus.</l>                 </lg><lb/>
<pb facs="#f0008"/>
<lg>                     <l><hi rendition="#in #red">W</hi><hi rendition="#blue">ir &#x017F;ingen Arien!</hi></l><lb/>
<l>Zwit&#x017F;cherten die Kanarien.</l><lb/>
<l><hi rendition="#red">Jch &#x017F;inge einen Choral!</hi></l><lb/>
<l>Sagte der Schakal.</l>                 </lg><lb/>
<lg>                     <l><hi rendition="#in #red">J</hi><hi rendition="#blue">ch &#x017F;chlage die Zimbel!</hi></l><lb/>
<l>Pfiff der Gimpel,</l><lb/>
<l><hi rendition="#red">Aber nur recht lei&#x017F;e!</hi></l><lb/>
<l>Bat die kleine Mei&#x017F;e!</l>                 </lg><lb/>
<lg>                     <l><hi rendition="#in #red">J</hi><hi rendition="#blue">ch &#x017F;itz' an der Ka&#x017F;&#x017F;'!</hi></l><lb/>
<l>Sagte der Vielfraß.</l><lb/>
<l><hi rendition="#red">Was ko&#x017F;tet's Entree?</hi></l><lb/>
<l>Fragte das Reh.</l><lb/>
<l><hi rendition="#red">Eine Mark bar!</hi></l><lb/>
<l>Pfiff der Star.</l>                 </lg>                 </lg><lb/>
<pb facs="#f0009"/>
</div>         </body>     </text> </TEI>