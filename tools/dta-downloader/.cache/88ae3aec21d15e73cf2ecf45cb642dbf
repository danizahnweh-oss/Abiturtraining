<fw type="catch" place="bottom"><hi rendition="#b"><hi rendition="#g">Sechste</hi></hi></fw><lb/>
<pb facs="#f0044" n="38"/>
<div n="2"><head><hi rendition="#c"><hi rendition="#b"><hi rendition="#g">Sechste Scene</hi>.</hi></hi></head><lb/>
<stage>Guido erscheint.</stage><lb/>
<sp who="#ADE"><speaker><hi rendition="#b"><hi rendition="#g">Adelheid</hi>.</hi></speaker><lb/>
<lg type="poem"><lg n="1"><l>Was willst du?</l></lg></lg></sp><lb/>
<sp who="#GUI"><speaker><hi rendition="#b"><hi rendition="#g">Guido</hi>.</hi></speaker><lb/>
<lg type="poem"><lg n="1"><l>Mir hat ju&#x0364;ngst ein Traum</l><lb/>
