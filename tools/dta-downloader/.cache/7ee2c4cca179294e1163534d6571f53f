<titlePage type="main"> <docTitle> <titlePart type="main"> <hi rendition="#b #g">Teut&#x017F;chland</hi><lb/>
und<lb/>
<hi rendition="#b #g">die Revolution</hi> <hi rendition="#b">.</hi><lb/>
</titlePart> </docTitle> <milestone unit="section" rendition="#hr"/><lb/>
<byline>Von<lb/>
<docAuthor> <hi rendition="#g">J</hi>. <hi rendition="#g">Görres</hi>.</docAuthor><lb/>
