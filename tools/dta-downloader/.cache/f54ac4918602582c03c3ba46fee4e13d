<titlePage type="main"><docTitle>     <titlePart type="main"><hi rendition="#b">Seifenbla&#x017F;en.</hi></titlePart><titlePart type="sub">Moderne Märchen</titlePart> </docTitle><lb/>
<byline>von<lb/>
<docAuthor><hi rendition="#b"><hi rendition="#g">Kurd Laßwitz</hi></hi>.</docAuthor> </byline><lb/>
<figure/><lb/>
