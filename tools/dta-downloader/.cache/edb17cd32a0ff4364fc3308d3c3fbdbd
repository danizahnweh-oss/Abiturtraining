<docTitle><titlePart type="main" xml:id="tpm2" prev="#tpm1"><hi rendition="#aq">Nr</hi>. 275. </titlePart></docTitle>  <docDate><hi rendition="#c">Würzburg, Samstag den 16. November.</hi> <hi rendition="#right">1850.</hi> </docDate><lb/>
