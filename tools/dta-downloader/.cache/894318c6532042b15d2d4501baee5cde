<div n="1"><head><hi rendition="#g">Per&#x017F;onen</hi>.</head><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<castList><castItem><role xml:id="ELI"><hi rendition="#g">Eli&#x017F;abeth</hi>, Ko&#x0364;nigin von England.</role></castItem><lb/>
<castItem><role xml:id="MARSTUA"><hi rendition="#g">Maria Stuart</hi>, Ko&#x0364;nigin von Schottland, Gefangne in England.</role></castItem><lb/>
<castItem><role xml:id="LEIGRA"><hi rendition="#g">Robert Dudley</hi>, Graf von <hi rendition="#g">Leice&#x017F;ter</hi>.</role></castItem><lb/>
<castItem><role><hi rendition="#g">Georg Talbot</hi>, Graf von <hi rendition="#g">Schrewsbury</hi>.</role></castItem><lb/>
<castItem><role xml:id="BURL"><hi rendition="#g">Wilhelm Cecil</hi>, Baron von Burleigh, Groß&#x017F;chatzmei&#x017F;ter.</role></castItem><lb/>
<castItem><role xml:id="KENTGRA"><hi rendition="#g">Graf von Kent</hi>.</role></castItem><lb/>
<castItem><role xml:id="DAV"><hi rendition="#g">Wilhelm Davi&#x017F;on</hi>, Staats&#x017F;ecretair.</role></castItem><lb/>
<castItem><role xml:id="AMI"><hi rendition="#g">Amias Paulet</hi>, Ritter, Hu&#x0364;ter der Maria.</role></castItem><lb/>
<castItem><role xml:id="MOR"><hi rendition="#g">Mortimer</hi>, &#x017F;ein Neffe.</role></castItem><lb/>
<castItem><role xml:id="AUBGRA"><hi rendition="#g">Graf Aube&#x017F;pine</hi>, franzo&#x0364;&#x017F;i&#x017F;cher Ge&#x017F;andter.</role></castItem><lb/>
<castItem><role xml:id="BELGRA"><hi rendition="#g">Graf Bellievre</hi>, außerordentlicher Bot&#x017F;chafter von Frankreich.</role></castItem><lb/>
<castItem><role xml:id="OKE"><hi rendition="#g">Okelly</hi>, Mortimers Freund.</role></castItem><lb/>
<castItem><role xml:id="DRUGRU"><hi rendition="#g">Drugeon Drury</hi>, zweiter Hu&#x0364;ter der Maria.</role></castItem><lb/>
<castItem><role xml:id="MEL"><hi rendition="#g">Melvil</hi>, ihr Haushofmei&#x017F;ter.</role></castItem><lb/>
<castItem><role xml:id="HANKEN"><hi rendition="#g">Hanna Kennedy</hi>, ihre Amme.</role></castItem><lb/>
<castItem><role xml:id="KURL"><hi rendition="#g">Margaretha Kurl</hi>, ihre Kammerfrau.</role></castItem><lb/>
<castItem><role xml:id="SCHEGRA"><hi rendition="#g">Scherif</hi> der Graf&#x017F;chaft.</role></castItem><lb/>
<castItem><role xml:id="OFFL"><hi rendition="#g">Offizier der Leibwache</hi>.</role></castItem><lb/>
<castItem><role xml:id="FRAENGHER"><hi rendition="#g">Franzo&#x0364;&#x017F;i&#x017F;che und Engli&#x017F;che Herren</hi>.</role></castItem><lb/>
<castItem><role xml:id="TRAB"><hi rendition="#g">Trabanten</hi>.</role></castItem><lb/>
<castItem><role xml:id="DIEENG"><hi rendition="#g">Hofdiener</hi> der Ko&#x0364;nigin von England.</role></castItem><lb/>
<castItem><role xml:id="DIESCHO"><hi rendition="#g">Diener</hi> und <hi rendition="#g">Dienerinnen</hi> der Ko&#x0364;nigin von Schottland.</role></castItem></castList></div><lb/>
