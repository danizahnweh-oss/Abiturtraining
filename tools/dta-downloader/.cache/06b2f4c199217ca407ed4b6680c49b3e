<titlePage type="main"><docTitle><titlePart type="main"> <hi rendition="#b"><hi rendition="#g">Maler Nolten</hi>.</hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/> <titlePart type="sub"><hi rendition="#g">Novelle<lb/>
in zwei Theilen</hi></titlePart></docTitle><lb/>
<byline>von<lb/>
<docAuthor><hi rendition="#b"><hi rendition="#g">Eduard Mörike</hi>.</hi></docAuthor></byline><lb/>
<milestone unit="section" rendition="#hr"/> <titlePart type="desc"><hi rendition="#g">Mit einer Mu&#x017F;ikbeilage</hi>.</titlePart><lb/>
<milestone unit="section" rendition="#hr"/> <titlePart type="volume"><hi rendition="#b"><hi rendition="#aq">II.</hi></hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/> <docImprint><pubPlace><hi rendition="#b">Stuttgart.</hi></pubPlace><lb/>
