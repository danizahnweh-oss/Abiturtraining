<div n="1">             <floatingText>                <front>                   <titlePage type="heading">                      <titlePart type="main">                         <hi rendition="#b">Beilage zu Nr 108 des &#x201E;<supplied>M</supplied>ähr. <supplied>T</supplied>agblattes&#x201C; dem 12. Mai 1897.</hi>                      </titlePart>                   </titlePage>                </front>                <lb/>
