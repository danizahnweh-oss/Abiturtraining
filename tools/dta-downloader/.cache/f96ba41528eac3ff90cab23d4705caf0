<div type="contents" n="1">       <head>Inhalts-Uebersicht.</head><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<table>         <row>           <cell>Vorwort</cell>           <cell>pag.</cell>           <cell rendition="#right">5.</cell>         </row>         <row>           <cell>I. Der Illusionismus</cell>           <cell>&#x3003;</cell>           <cell rendition="#right">7.</cell>         </row>         <row>           <cell>II. Der Dämonismus</cell>           <cell>&#x3003;</cell>           <cell rendition="#right">27.</cell>         </row>         <row>           <cell>III. Der Individualismus</cell>           <cell>&#x3003;</cell>           <cell rendition="#right">52.</cell>         </row>       </table>       <milestone rendition="#hr" unit="section"/><lb/>
