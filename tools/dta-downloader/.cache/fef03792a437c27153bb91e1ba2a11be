<milestone unit="section" rendition="#hr"/>                   <p>                     <hi rendition="#et">J. R. <hi rendition="#g">Engau</hi> <hi rendition="#i">Di&#x017F;&#x017F;. de delictis monetariis</hi>. 1750.</hi>                   </p>                   <lb/>
