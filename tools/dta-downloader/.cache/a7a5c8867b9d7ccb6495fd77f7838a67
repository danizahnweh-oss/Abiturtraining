<hi rendition="#fr">neuen Serapionsbrüder.</hi>                 </titlePart><lb/>
<milestone rendition="#hr" unit="section"/>                 <byline><hi rendition="#g">Roman in drei Bänden</hi><lb/>
von<lb/>
<docAuthor>Karl Gutzkow.</docAuthor></byline>                 <milestone rendition="#hr" unit="section"/>                 <titlePart type="volume"><hi rendition="#g">Dritter Band.</hi></titlePart><lb/>
<milestone rendition="#hr" unit="section"/>                 <milestone rendition="#hr" unit="section"/>                 <docImprint>                     <pubPlace>Breslau</pubPlace>.<lb/>
