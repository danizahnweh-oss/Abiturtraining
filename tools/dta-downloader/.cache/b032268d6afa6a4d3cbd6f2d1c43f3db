<milestone unit="section" rendition="#hr"/>           <note place="left">             <hi rendition="#aq">I.</hi>           </note>           <p><hi rendition="#in">E</hi>ines der wichtig&#x017F;ten Stu&#x0364;cke der Teut&#x017F;chen Reichs-<lb/>
