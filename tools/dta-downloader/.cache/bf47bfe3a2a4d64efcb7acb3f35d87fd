<titlePage type="heading">             <docTitle>               <titlePart type="main"><hi rendition="#fr">Mainzer Journal.</hi></titlePart>             </docTitle>             <milestone rendition="#hr" unit="section"/><lb/>
<docImprint>N<hi rendition="#sup">ro</hi> 242.                <docDate><hi rendition="#c">Donnerstag, den 11. October.</hi> <hi rendition="#right">1849.</hi></docDate></docImprint></titlePage><lb/>
