<fw type="catch" place="bottom">in</fw></note></p></div></div><lb/>
<fw type="sig" place="bottom">R 2</fw><fw type="catch" place="bottom"><hi rendition="#b">Kirche</hi></fw><lb/>
<pb n="260" facs="#f0284"/>
