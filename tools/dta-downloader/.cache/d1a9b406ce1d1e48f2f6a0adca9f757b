<pb n="40" facs="#f0064"/>
<fw type="header" place="top"><hi rendition="#b">Palla&#x017F;t Giu&#x017F;tiniani.</hi></fw><lb/>
<milestone unit="section" rendition="#hr"/> <div n="2"><head><hi rendition="#b"><hi rendition="#g">Sech&#x017F;tes Zimmer.</hi></hi></head><lb/>
<p>&#x2020; <hi rendition="#fr">St. Peter vom Engel geweckt,</hi> von <hi rendition="#fr">Hont-<lb/>
