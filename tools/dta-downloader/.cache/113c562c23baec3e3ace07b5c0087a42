<docImprint>N<hi rendition="#sup">ro</hi> 107.   <docDate><hi rendition="#c">Dienstag, den 10. October.</hi> <hi rendition="#right">1848.</hi><lb/>
</docDate></docImprint></titlePage>       <milestone rendition="#hr" unit="section"/><lb/>
