<hi rendition="#g">Couthony</hi></persName>, <persName ref="http://d-nb.info/gnd/116020849">James D.<hi rendition="#g"> Dana</hi></persName>, <persName ref="http://d-nb.info/gnd/117692727">T. R. <hi rendition="#g">Peale</hi></persName> und <persName ref="http://d-nb.info/gnd/117378569">Horatio <hi rendition="#g">Hale</hi></persName><lb/>
