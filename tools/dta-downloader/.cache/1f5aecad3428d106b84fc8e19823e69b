<p>             <hi rendition="#c">Reichthum einer Dreifelderwirth&#x017F;chaft beim Ertrage von 10<lb/>
Ko&#x0364;rnern.</hi>           </p>           <lb/>
<list>             <item>Grade</item>             <lb/>
<item>1&#x017F;tes Feld. Rocken <space dim="horizontal"/> 500°</item>             <lb/>
<item>2tes Feld. Ger&#x017F;te <space dim="horizontal"/> 400°</item>             <lb/>
<item>3tes Feld. Brache <space dim="horizontal"/> 325°</item>           </list>           <lb/>
