<titlePage type="heading" xml:id="tp1a" next="#tp1b">         <docImprint><docDate>1836.</docDate></docImprint>       </titlePage>      <div type="jExpedition"><p><hi rendition="#c">Erscheint jeden Sonnabend.</hi></p></div>       <titlePage type="heading" xml:id="tp1b" prev="#tp1a">      <titlePart type="sub"><hi rendition="#right">N<hi rendition="#sup">ro</hi> 1.</hi></titlePart><lb/>
<milestone rendition="#hr" unit="section"/><lb/>
<titlePart type="main">          <hi rendition="#c"><hi rendition="#fr">Conversations=Blatt<lb/>
