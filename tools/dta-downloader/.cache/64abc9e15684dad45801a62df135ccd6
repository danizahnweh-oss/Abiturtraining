<titlePage type="main"> <docTitle> <titlePart type="main"> <hi rendition="#b">Ae&#x017F;thetik des Häßlichen</hi>.</titlePart> <milestone unit="section" rendition="#hr"/> </docTitle><lb/>
<byline>Von<lb/>
<docAuthor> <hi rendition="#b #g">Karl Ro&#x017F;enkranz</hi><hi rendition="#b">.</hi></docAuthor> <milestone unit="section" rendition="#hr"/> </byline><lb/>
