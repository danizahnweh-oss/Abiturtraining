<docAuthor><hi rendition="#g">Friedrich Schlegel.</hi></docAuthor></byline><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="desc"><hi rendition="#g">Er&#x017F;ter Band.</hi></titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<docImprint><pubPlace><hi rendition="#g">Lu&#x0364;beck und Leipzig</hi></pubPlace>,<lb/>
