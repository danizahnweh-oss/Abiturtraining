<titlePage type="heading" xml:id="tp1a" next="#tp1b">             <docImprint>                <docDate>                   <hi rendition="#b">Nr. 47 Uznach,</hi> Mittwoch den 14. Juni 1899. 44. Jahrgang.</docDate>             </docImprint>             <lb/>
<milestone unit="section" rendition="#hr"/>             <lb/>
<titlePart type="main">                <hi rendition="#b">St. Galler Volksblatt.</hi>             </titlePart>             <lb/>
