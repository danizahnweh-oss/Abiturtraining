<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="sub">VORTRAG<lb/>
GEHALTEN AM SCHINKELFEST<lb/>
13. MÄRZ 1893</titlePart>         </docTitle>         <lb/>
<byline>VON<lb/>
<docAuthor><hi rendition="#b">JAMES HOBRECHT</hi></docAuthor></byline>         <lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<docImprint>           <pubPlace>BERLIN</pubPlace>           <docDate>1893</docDate>           <lb/>
<publisher><hi rendition="#g">VERLAG VON WILHELM ERNST &amp; SOHN</hi><lb/>
(VORMALS ERNST &amp; KORN)</publisher>         </docImprint>       </titlePage>       <lb/>
<pb n="[2]" facs="#f0008"/>
<div type="copyright">         <milestone unit="section" rendition="#hr"/><lb/>
