<pb facs="#f0001"/>
<titlePage type="main">             <docTitle>                 <titlePart type="main">                         <hi rendition="#b"><hi rendition="#g">Jahrbuch</hi></hi><lb/>
für<lb/>
<hi rendition="#b">Jugend- und Volksspiele.</hi>                     </titlePart>                 <milestone rendition="#hr" unit="section"/>             </docTitle>                 <byline>                     herausgegeben von<lb/>
<hi rendition="#b">E. von Schenckendorff,</hi> und <hi rendition="#b">Dr. med. F. A. Schmidt,</hi><lb/>
</byline>                 <titlePart type="desc"> Mitgliede des Hauses der Abgeordneten, Mitgliede des                     Ausschusses der deutschen Turnerschaft.<lb/>
<hi rendition="#g">Vorsitzenden des Zentralausschusses</hi><lb/>
zur Förderung                     der Jugend- und Volksspiele in Deutschland.<lb/>
</titlePart>                 <milestone rendition="#hr" unit="section"/>                 <titlePart type="volume">                     <hi rendition="#g">Dritter Jahrgang.</hi><lb/>
</titlePart>                 <docImprint>                     <docDate>1894.</docDate><lb/>
<figure/><lb/>
<pubPlace><hi rendition="#b">Leipzig,</hi></pubPlace><lb/>
