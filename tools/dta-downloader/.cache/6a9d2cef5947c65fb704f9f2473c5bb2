<milestone unit="section" rendition="#hr"/><lb/>
<fw type="catch" place="bottom"><hi rendition="#b">Der</hi></fw><lb/>
<pb n="302" facs="#f0318"/>
<fw type="header" place="top">Der Zweiffeler.</fw><lb/>
<div n="1"><head><hi rendition="#b"><hi rendition="#g">Der Zweiffeler.</hi></hi></head><lb/>
<lg type="poem"><l><hi rendition="#in">E</hi>in Zweifler i&#x017F;t ein Men&#x017F;ch, der in der<lb/>
