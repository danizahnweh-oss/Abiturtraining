<item>Ab&#x017F;chied <space dim="horizontal"/> <ref>229</ref></item><lb/>
<item><hi rendition="#aq">Tout comme chez nous</hi> <space dim="horizontal"/> <ref>230</ref></item><lb/>
<item>Peregrina <hi rendition="#aq">I</hi>.&#x2013;<hi rendition="#aq">V</hi>. <space dim="horizontal"/> <ref>231</ref></item><lb/>
<item>Um Mitternacht <space dim="horizontal"/> <ref>236</ref></item> </list><lb/>
</div> <milestone unit="section" rendition="#hr"/>
