<pb n="[1]" facs="#f0001"/>
<titlePage type="main">
<imprimatur>
<hi rendition="#c"><hi rendition="#b">Mit allergna&#x0364;dig&#x017F;ter Kay&#x017F;erlichen
Freyheit.</hi></hi></imprimatur>
<lb/>
<docTitle>
<titlePart type="main"><hi rendition="#b">Staats- und <figure/> Gelehrte</hi><lb/>
