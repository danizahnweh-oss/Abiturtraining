<pb facs="#f0001" n="97"/>
<div n="1"><head><hi rendition="#fr"><hi rendition="#b">Proben neuer Dramen</hi></hi></head><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<div n="2"><head><hi rendition="#aq"><hi rendition="#b">II.</hi></hi><lb/>
<hi rendition="#b"><hi rendition="#g">Patkul.</hi></hi><lb/>
Politisches Trauerspiel in 5 Aufzügen, von Karl Gutzkow.</head><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<div n="3"><head><hi rendition="#g">Personen</hi></head><lb/>
<cb type="start"/>
<castList><castItem><role xml:id="FRI"><hi rendition="#g">Friedrich August,</hi></role> <roleDesc>König von Po-<lb/>
len und Churfürst von Sachsen.</roleDesc></castItem><lb/>
<castItem><role xml:id="ANN"><hi rendition="#g">Churfürstin Anna Sophia,</hi></role> <roleDesc>Mut-<lb/>
ter Friedrich August's.</roleDesc></castItem><lb/>
