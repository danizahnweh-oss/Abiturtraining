Hofrath</byline>
<docTitle rendition="#c">
<titlePart type="main"><hi rendition="#g">über
den<lb/>
Bildungstrieb</hi>.</titlePart>
</docTitle>
<figure xml:id="tx000055_007a">
<graphic url="images/tx000055_007a"/>
</figure>
<milestone unit="section" rendition="#hr"/><lb/>
