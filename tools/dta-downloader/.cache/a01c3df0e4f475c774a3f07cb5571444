zum dritten Theile des Salons<lb/>
</titlePart>         <byline>           von<lb/>
<docAuthor><hi rendition="#b">H. Heine.</hi></docAuthor><lb/>
</byline>         <milestone rendition="#hr" unit="section"/><lb/>
<docImprint>           <pubPlace>Hamburg</pubPlace>, <docDate><hi rendition="#b">1837</hi></docDate><lb/>
