Der Anführer &#x03B3;&#x03B5;&#x03F1;&#x03B1;&#x03BD;&#x03BF;&#x03C5;&#x03BB;&#x03BA;&#x1F78;&#x03C2; He&#x017F;ych; es kamen dabei Schla&#x0364;ge vor,<lb/>
daher der &#x0394;&#x03AE;&#x03BB;&#x03BF;&#x03C5; &#x03BA;&#x03B1;&#x03BA;&#x1F78;&#x03C2; &#x03B2;&#x03C9;&#x03BC;&#x1F78;&#x03C2; He&#x017F;ych; &#x03C0;&#x03B1;&#x03F1;&#x03B1;&#x03BB;&#x03BB;&#x03AC;&#x03BE;&#x03B5;&#x03B9;&#x03C2; &#x03BA;&#x03B1;&#x1F76; &#x1F00;&#x03BD;&#x03B5;&#x03BB;&#x03AF;&#x03BE;&#x03B5;&#x03B9;&#x03C2;,<lb/>
