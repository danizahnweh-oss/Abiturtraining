&#x039D;&#x03B9;&#x03BA;&#x03CC;&#x03BB;&#x03B1;&#x03BF;&#x03C2; &#x03C4;&#x03B5;&#x03C4;&#x03AC;&#x03F1;&#x03C4;&#x1FF3;. Steph. Darnach erga&#x0364;nzen wir nun Ephoros<lb/>
bei Str. 8, 361 <hi rendition="#aq">c</hi>. &#x017F;o: &#x1F65;&#x03C3;&#x03C4;&#x03B5; &#x03C4;&#x1F74;&#x03BD; &#x03A3;&#x03C4;&#x03B5;&#x03BD;&#x03CD;&#x03BA;&#x03BB;&#x03B1;&#x03F1;&#x03BF;&#x03BD; &#x03BC;&#x1F72;&#x03BD; &#x1F10;&#x03BD; &#x03C4;&#x1FF7; &#x03BC;&#x03AD;&#x03C3;&#x1FF3;<lb/>
