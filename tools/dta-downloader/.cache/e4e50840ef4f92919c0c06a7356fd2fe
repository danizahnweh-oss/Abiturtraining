<titlePage type="heading" xml:id="title2" prev="#title1">             <docImprint>                <docDate>                   <hi rendition="#b">Nr. 23. Mittwoch, den 21. März 1900. 20. Jahrg.</hi>                </docDate>             </docImprint>             <lb/>
