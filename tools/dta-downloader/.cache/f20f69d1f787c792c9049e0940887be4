<lb/>
<pb n="[III]" facs="#f0007"/>
<titlePage type="main"><docTitle><titlePart type="main">Reformation oder Revolution?</titlePart></docTitle><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<byline>Für Katholiken und Prote&#x017F;tanten beantwortet<lb/>
von<lb/>
<docAuthor><hi rendition="#b">Johann Diefenbach</hi></docAuthor>,<lb/>
Jn&#x017F;pector an der Deut&#x017F;ch-Ordenskirche zu Frankfurt a. M.</byline><lb/>
<epigraph><quote><hi rendition="#aq">Facta loquuntur.</hi></quote></epigraph><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="desc">Mit kirchlicher Approbation.</titlePart><lb/>
<milestone unit="section" rendition="#hr"/><lb/>
