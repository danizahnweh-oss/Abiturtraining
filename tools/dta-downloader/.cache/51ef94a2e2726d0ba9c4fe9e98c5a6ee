<milestone unit="section" rendition="#hr"/>         <byline><hi rendition="#g">Von</hi><lb/>
<docAuthor><hi rendition="#g">Ju&#x017F;tus Liebig,</hi></docAuthor><lb/>
<hi rendition="#aq">Dr.</hi> der Medizin und Philo&#x017F;ophie,<lb/>
Profe&#x017F;&#x017F;or der Chemie an der Ludwigs-Univer&#x017F;ität zu Gießen,<lb/>
