<titlePage type="heading"><titlePart type="main" xml:id="tpm2" prev="#tpm1">N<hi rendition="#sup">ro</hi> 1056.</titlePart> </titlePage>  <docDate><hi rendition="#c">Frankfurt a. M., 28. Juli.</hi> <hi rendition="#right">1877.</hi> </docDate><lb/>
