<titlePage type="main"> <docTitle> <titlePart type="main"> <hi rendition="#g">Peter Schlemihl&#x2019;s</hi><lb/>
<hi rendition="#b">wundersame Geschichte,</hi><lb/>
</titlePart> </docTitle> <byline> <hi rendition="#g">mitgetheilt<lb/>
von</hi><lb/>
<docAuthor> <hi rendition="#b">Adelbert von Chamisso.</hi><lb/>
</docAuthor> </byline> <milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="volume"> Zweite mit den Liedern und Balladen des Verfa&#x017F;&#x017F;ers<lb/>
vermehrte Ausgabe.<lb/>
</titlePart> <milestone unit="section" rendition="#hr"/><lb/>
<titlePart type="desc"> Mit &#x017F;echs Kupfern nach George Cruik&#x017F;hank<lb/>
und einem Titelkupfer.<lb/>
</titlePart> <milestone unit="section" rendition="#hr"/><lb/>
<docImprint> <pubPlace><hi rendition="#g">Nürnberg,</hi></pubPlace><lb/>
<hi rendition="#g">bei</hi><lb/>
<publisher><hi rendition="#g">Johann Leonhard Schrag.</hi></publisher><lb/>
