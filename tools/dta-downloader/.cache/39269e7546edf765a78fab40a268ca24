<titlePage type="main">         <docTitle>           <titlePart type="main">             <hi rendition="#b">               <hi rendition="#g">Beygabe<lb/>
zum er&#x017F;ten Bande<lb/>
der<lb/>
italieni&#x017F;chen For&#x017F;chungen</hi>             </hi>           </titlePart>         </docTitle>         <lb/>
<byline>von<lb/>
<docAuthor><persName ref="http://d-nb.info/gnd/118987224">C. F. <hi rendition="#g">von Rumohr</hi></persName>.</docAuthor></byline>         <lb/>
<milestone unit="section" rendition="#hr"/>         <docImprint>           <pubPlace>             <hi rendition="#g"><placeName>Berlin</placeName> 1827.</hi>           </pubPlace>           <lb/>
<milestone unit="section" rendition="#hr"/>           <pubPlace><hi rendition="#g"><placeName>Hamburg</placeName></hi>,<lb/>
</pubPlace>           <publisher>             <hi rendition="#g">bey Perthes und Be&#x017F;&#x017F;er.</hi>           </publisher>         </docImprint>       </titlePage>
