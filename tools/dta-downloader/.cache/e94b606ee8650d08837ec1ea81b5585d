<div n="1"><p><floatingText><front><titlePage type="heading"><docDate>Donner&#x017F;tag,</docDate> <docTitle><titlePart type="main"><hi rendition="#b">Zweites Morgenblatt, Nr. 343 der Allgemeinen Zeitung.</hi></titlePart></docTitle> <docDate>11. December 1890.</docDate></titlePage></front><lb/>
