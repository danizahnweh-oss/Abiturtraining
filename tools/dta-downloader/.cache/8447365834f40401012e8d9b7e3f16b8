<div n="1" type="jPoliticalNews">             <head>                <hi rendition="#b">Politi&#x017F;che Rund&#x017F;chau.</hi>             </head>             <lb/>
<div n="2">                <head>                   <hi rendition="#b">Oe&#x017F;terreich-Ungarn.</hi>                </head>                <lb/>
